# Copy to .env for local work, and set the same names in the host's environment for a
# deployment. NEVER commit the real values.

# The only secret this site has. Test and live keys must belong to the SAME account as
# the publishable key below.
STRIPE_SECRET_KEY=sk_test_replace_me

# The publishable key. Public by design — it is in the client bundle either way — so this
# is not about hiding it. It is here so that which account and which MODE this site
# charges against is decided by the environment and nothing else.
#
# There is no fallback in the code any more. If this is unset the donation sheet refuses
# to load and says so, which is the point: a missing value used to mean the site quietly
# took donations in test mode, where nobody is charged and every screen looks correct.
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
