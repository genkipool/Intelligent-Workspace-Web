# Copy to .env for `vercel dev`, or set with `vercel env add` for deployments.
# NEVER commit the real value. This is the only secret the site has.
STRIPE_SECRET_KEY=sk_test_replace_me

# The publishable key. Public by design — it is in the client bundle either way — so this
# is here to switch test and live without editing code, not to keep anything hidden. It
# must belong to the SAME Stripe account as STRIPE_SECRET_KEY above.
# Unset falls back to the test key committed in src/scripts/pay.ts.
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
