# Astro
dist/
.astro/

# Vercel
.vercel

# Dependencies
node_modules/

# Secrets. The only one this project has is STRIPE_SECRET_KEY.
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.log

# Scratch from agent sessions. Already excluded from Prettier for the same reason.
.agents/

# Self-signed certificate for `pnpm dev --https`. Regenerated on demand, never shared.
#
# The glob is deliberate. The rule used to be `.certs/` alone, and renaming the folder to
# `.certs.off` to turn https off in dev was enough to take it out from under the rule — a
# private key reached a public repository that way, in 223643c. `.certs*` covers the
# rename, whatever suffix the next one picks.
.certs*/
