---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import IconSprite from '@/components/IconSprite.astro';
import ScrollButtons from '@/components/ScrollButtons.astro';
import { chromeIconNames, type IconName } from '@/data/icons';
import { useTranslations, localisePath } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import { site } from '@/data/site';

interface Props {
    lang: Lang;
    title?: string;
    description?: string;
    noindex?: boolean;
    /**
     * The glyphs this page's sprite carries. A page pays for the whole set only if it
     * draws enough of them to be worth it, so the default is the chrome's own pair and
     * the landing pages ask for everything. A name left out here renders an empty icon,
     * which is why `icon-sprite.test.ts` checks every `<use>` against the built HTML.
     */
    icons?: readonly IconName[];
    /**
     * Whether this page joins the client-side router.
     *
     * The contribution sheet must not. A view transition swaps the DOM without re-running
     * module scripts, so arriving at `/pay` from a link inside the site left `pay.ts`
     * unexecuted: Stripe was never initialised and the sheet sat on "Loading the secure
     * payment form" for ever, while opening the same URL directly worked perfectly. The
     * links into it carry `data-astro-reload` for the same reason; this is the other half,
     * and it also saves the sheet the router's 16 KB, which it has no links to spend on.
     */
    transitions?: boolean;
    /**
     * Whether this page gets the floating scroll buttons.
     *
     * On by default: they hide themselves on a page with nothing to scroll, so the only
     * pages that need to say no are the ones where they would be in the way rather than
     * merely idle. That is the contribution sheet — a card form is no place for a control
     * that floats over it, and on a phone the sheet is exactly tall enough to scroll.
     */
    scrollButtons?: boolean;
}

const {
    lang,
    title,
    description,
    noindex = false,
    icons = chromeIconNames,
    transitions = true,
    scrollButtons = true,
} = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');

/**
 * The social card, in the language of the page it belongs to.
 *
 * One card for both languages meant every Spanish share carried an English headline —
 * and the reverse — so there are two, generated by `scripts/og.mjs` from the same
 * template. `OG_VERSION` is what makes a redraw reach the caches: Facebook, X, Slack and
 * WhatsApp keep a scraped card for days and only a changed URL evicts it.
 */
const OG_VERSION = 4;
const ogImage = new URL(`/assets/og-${lang}.png?v=${OG_VERSION}`, Astro.site).href;
const ogAlt = t('meta.ogAlt');
const ogLocale = lang === 'es' ? 'es_ES' : 'en_GB';
const ogLocaleAlternate = lang === 'es' ? 'en_GB' : 'es_ES';

const bare = lang === 'en' ? Astro.url.pathname : Astro.url.pathname.replace(`/${lang}`, '') || '/';
const alternates = (['en', 'es'] as const).map((code) => ({
    code,
    href: new URL(localisePath(code, bare), Astro.site).href,
}));

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: site.name,
    operatingSystem: 'Google Chrome, Brave, Microsoft Edge, Opera, Vivaldi',
    applicationCategory: 'ProductivityApplication',
    description: pageDescription,
    url: new URL(Astro.url.pathname, Astro.site).href,
    offers: {
        '@type': 'Offer',
        price: '0.00',
        priceCurrency: 'USD',
    },
    author: {
        '@type': 'Organization',
        name: site.owner,
        url: site.sourceUrl,
    },
};
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />

        {
            /*
            Four icons, because no single format is enough.

            Google Search will not render an SVG favicon, so a `.ico` has to exist at the
            root — the crawler asks for `/favicon.ico` whether or not anything links to
            it. The SVG is still first for browsers that take it: it is 1 KB and stays
            sharp at any size. The PNG covers the rest, and `apple-touch-icon` is what
            iOS puts on a home screen instead of a screenshot of the page.
        */
        }
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />

        {
            /*
            The browser chrome on a phone. The first entry wins only where the media query
            matches, so the unconditional one below it is both the dark answer and the
            plain tag a crawler looks for.
        */
        }
        <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7faf8" />
        <meta name="theme-color" content="#1b2631" />

        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
        {noindex && <meta name="robots" content="noindex, nofollow" />}
        {!noindex && alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
        {!noindex && <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />}

        {/* OpenGraph & Twitter Cards */}
        <meta property="og:site_name" content={site.name} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content={ogLocale} />
        <meta property="og:locale:alternate" content={ogLocaleAlternate} />
        <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:secure_url" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:alt" content={ogAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={pageDescription} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={ogAlt} />

        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        <slot name="head" />

        {
            /* Zero-flash client-side transitions for the language switch. Off on the
               contribution sheet, which has no links and cannot survive a DOM swap. */
            transitions && <ClientRouter />
        }

        <!-- Instantaneous theme synchronization & Zero-Jump Scroll Retention -->
        <script is:inline>
            function applyTheme() {
                try {
                    const stored = localStorage.getItem('iw-theme') || localStorage.getItem('theme-mirror');
                    if (stored === 'light') {
                        document.documentElement.dataset.theme = 'light';
                    } else if (stored === 'dark') {
                        document.documentElement.dataset.theme = 'dark';
                    } else if (
                        window.matchMedia &&
                        window.matchMedia('(prefers-color-scheme: light)').matches
                    ) {
                        document.documentElement.dataset.theme = 'light';
                    } else {
                        document.documentElement.dataset.theme = 'dark';
                    }
                } catch {}
            }
            applyTheme();
            document.addEventListener('astro:after-swap', applyTheme);
            document.addEventListener('astro:page-load', applyTheme);

            // Synchronous scroll retention on language toggle so the page never jumps to 0
            document.addEventListener('click', (e) => {
                const target = e.target && e.target.closest && e.target.closest('.lang-pill');
                if (target) {
                    sessionStorage.setItem('iw_lang_scroll', String(window.scrollY));
                }
            });

            document.addEventListener('astro:before-swap', (e) => {
                const saved = sessionStorage.getItem('iw_lang_scroll');
                if (saved !== null) {
                    const y = parseInt(saved, 10);
                    e.newDocument.documentElement.scrollTop = y;
                    e.newDocument.body.scrollTop = y;
                }
            });

            document.addEventListener('astro:after-swap', () => {
                const saved = sessionStorage.getItem('iw_lang_scroll');
                if (saved !== null) {
                    const y = parseInt(saved, 10);
                    window.scrollTo({ top: y, behavior: 'instant' });
                    sessionStorage.removeItem('iw_lang_scroll');
                }
            });
        </script>
    </head>
    <body>
        <a class="skip" href="#main">{t('nav.skip')}</a>

        {
            /*
            The ambient canvas: one fixed layer carrying the black-to-viridian gradient and
            the dot grid over it. The two absolutely positioned blobs that used to sit here
            are gone — `.ambient-bg` paints their radial gradients itself now, which is two
            fewer elements and one fewer compositing layer for the same picture.
        */
        }
        <div class="ambient-bg" aria-hidden="true">
            <div class="dot-grid"></div>
        </div>

        <slot />

        {scrollButtons && <ScrollButtons lang={lang} />}

        <Analytics />
        <SpeedInsights />

        <IconSprite names={icons} />

        <script src="@/scripts/reveal.ts"></script>
    </body>
</html>

<style is:global>
    .skip {
        position: absolute;
        left: -9999px;
    }

    .skip:focus {
        left: var(--gutter);
        top: 16px;
        z-index: 100;
        background: var(--bg-panel-color);
        color: var(--text-color);
        padding: 10px 18px;
        border: 1px solid var(--action-color);
        border-radius: var(--radius-sm);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    }
</style>
