---
import { useTranslations, localisePath } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import Icon from '@/components/Icon.astro';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const payUrl = localisePath(lang, '/pay');
---

<section class="section-container wrap contribution-section">
    <!-- Open Fluid Banner without Box Container -->
    <div class="contribution-fluid-inner" data-reveal>
        <div class="contribution-accent-glow" aria-hidden="true"></div>
        <div class="contribution-content">
            <span class="contribution-eyebrow">{t('contribute.eyebrow')}</span>
            <h2 class="contribution-headline">{t('contribute.title')}</h2>
            <p class="contribution-body-text">{t('contribute.body')}</p>
            <div class="contribution-actions-row">
                <a href={payUrl} class="btn-primary contribution-cta-btn" data-astro-reload>
                    <Icon name="heart" />
                    <span>{t('contribute.cta')}</span>
                </a>
            </div>
            <span class="contribution-security-note">
                <Icon name="lock" size={15} />
                <span>{t('contribute.secured')}</span>
            </span>
        </div>
    </div>
</section>

<style>
    .contribution-section {
        position: relative;
    }

    .contribution-fluid-inner {
        position: relative;
        padding: clamp(40px, 6vw, 72px) 0;
    }

    .contribution-accent-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: clamp(300px, 60vw, 700px);
        height: 250px;
        background: radial-gradient(circle, var(--ambient-glow-1) 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
    }

    .contribution-content {
        position: relative;
        z-index: 1;
        max-width: 840px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 16px;
    }

    .contribution-eyebrow {
        font-size: 0.78rem;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--action-color);
    }

    :root[data-theme='light'] .contribution-eyebrow {
        color: var(--header-color);
    }

    .contribution-headline {
        font-size: clamp(2.2rem, 3.8vw, 3rem);
        color: var(--text-color);
        line-height: 1.15;
    }

    .contribution-body-text {
        font-size: 1.12rem;
        color: var(--text-soft);
        line-height: 1.65;
        max-width: 720px;
    }

    .contribution-actions-row {
        margin-top: 8px;
    }

    .contribution-cta-btn {
        min-width: 220px;
        min-height: 52px;
        font-size: 1.05rem;
    }

    .contribution-security-note {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 0.84rem;
        color: var(--text-muted);
    }
</style>
