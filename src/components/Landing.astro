---
/**
 * Intelligent Workspace — Main Landing Page Orchestrator.
 * Complete premium layout with dedicated, unmixed marketing showcases and zero-warning architecture.
 */
/*
 * The extension's own stylesheet, imported here rather than in `Base.astro`: every
 * class in it belongs to a shot on this page, and the donation sheet and the error
 * pages were downloading all 25 KB of it to draw none.
 */
import '@/styles/extension-ui.css';
import type { Lang } from '@/i18n/ui';
import Nav from '@/components/Nav.astro';
import Hero from '@/components/Hero.astro';
import Problem from '@/components/Problem.astro';
import Features from '@/components/Features.astro';
import OmnibarShowcase from '@/components/OmnibarShowcase.astro';
import ReaderTTSShowcase from '@/components/ReaderTTSShowcase.astro';
import MediaShowcase from '@/components/MediaShowcase.astro';
import BackupCaptureShowcase from '@/components/BackupCaptureShowcase.astro';
import ActivityDashboardShowcase from '@/components/ActivityDashboardShowcase.astro';
import BookmarksShowcase from '@/components/BookmarksShowcase.astro';
import SnippetsShowcase from '@/components/SnippetsShowcase.astro';
import SwissArmyBento from '@/components/SwissArmyBento.astro';
import Comparison from '@/components/Comparison.astro';
import KeyboardBand from '@/components/KeyboardBand.astro';
import Trust from '@/components/Trust.astro';
import Faq from '@/components/Faq.astro';
import Team from '@/components/Team.astro';
import DonateBand from '@/components/DonateBand.astro';
import SiteFooter from '@/components/SiteFooter.astro';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
---

<Nav lang={lang} />

<main id="main">
    <Hero lang={lang} />
    <Problem lang={lang} />
    <Features lang={lang} />
    <OmnibarShowcase lang={lang} />
    <ReaderTTSShowcase lang={lang} />
    <MediaShowcase lang={lang} />
    <BackupCaptureShowcase lang={lang} />
    <ActivityDashboardShowcase lang={lang} />
    <BookmarksShowcase lang={lang} />
    <SnippetsShowcase lang={lang} />
    <SwissArmyBento lang={lang} />
    <Comparison lang={lang} />
    <KeyboardBand lang={lang} />
    <Trust lang={lang} />
    <Faq lang={lang} />
    <Team lang={lang} />
    <DonateBand lang={lang} />
</main>

<SiteFooter lang={lang} />
