---
/**
 * Two things the extension does that nothing on this page had room for: the captures
 * and the backups. Both are drawn with the extension's own interfaces, the gallery
 * from `ScreenshotGalleryView.svelte` and the backed-up group from `GroupCard.svelte`.
 */
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import SectionHeader from '@/components/SectionHeader.astro';
import PanelGallery from '@/components/shots/PanelGallery.astro';
import PanelGroupList from '@/components/shots/PanelGroupList.astro';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="capturas-copias" class="section-container wrap">
    <SectionHeader lang={lang} eyebrowKey="keep.badge" titleKey="keep.title" subtitleKey="keep.subtitle" />

    <!-- Captures on one row, backups on the next, each beside its own panel. -->
    <div class="keep-row" data-reveal>
        <div class="keep-visual">
            <PanelGallery
                title={t('keep.shot.gallery')}
                shots={[
                    { title: t('keep.shot.s1'), pinned: true },
                    { title: t('keep.shot.s2') },
                    { title: t('keep.shot.s3') },
                    { title: t('keep.shot.s4') },
                ]}
                options={[
                    { label: t('keep.opt.visible'), active: true },
                    { label: t('keep.opt.full'), key: 'cs' },
                    { label: t('keep.opt.parts') },
                    { label: t('keep.opt.area'), key: 'ca' },
                    { label: t('keep.opt.group') },
                ]}
            />
        </div>

        <div class="keep-info">
            <h3 class="keep-title">{t('keep.capture.title')}</h3>
            <p class="keep-lead">{t('keep.capture.lead')}</p>
            <ul class="keep-list">
                <li>{t('keep.capture.f1')}</li>
                <li>{t('keep.capture.f2')}</li>
                <li>{t('keep.capture.f3')}</li>
            </ul>
        </div>
    </div>

    <div class="keep-row reversed" data-reveal>
        <div class="keep-info">
            <h3 class="keep-title">{t('keep.backup.title')}</h3>
            <p class="keep-lead">{t('keep.backup.lead')}</p>
            <ul class="keep-list">
                <li>{t('keep.backup.f1')}</li>
                <li>{t('keep.backup.f2')}</li>
                <li>{t('keep.backup.f3')}</li>
            </ul>
        </div>

        <div class="keep-visual">
            <PanelGroupList
                title={t('keep.shot.groups')}
                duplicates="3"
                groups={[
                    {
                        name: t('keep.shot.g1'),
                        color: 'c-green',
                        count: '2/4',
                        tabs: [
                            { title: 'Intelligent Workspace · Pull requests', fav: 'fav-gh', active: true },
                            { title: 'IW-214 · Panel de actividad web', fav: 'fav-ji', seen: true },
                        ],
                    },
                    {
                        name: t('keep.shot.g2'),
                        color: 'c-cyan',
                        count: '12',
                        backup: true,
                        tabs: [
                            { title: 'Routing · Astro Docs', fav: 'fav-as' },
                            { title: 'View transitions · MDN', fav: 'fav-mdn' },
                            { title: 'Server islands · Astro Docs', fav: 'fav-as' },
                        ],
                    },
                    {
                        name: t('keep.shot.g3'),
                        color: 'c-orange',
                        count: '9',
                        backup: true,
                        tabs: [{ title: 'Landing · panel lateral', fav: 'fav-fg' }],
                    },
                ]}
            />
        </div>
    </div>
</section>

<style>
    .keep-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(32px, 5vw, 72px);
        align-items: center;
    }

    .keep-row + .keep-row {
        margin-top: clamp(48px, 6vw, 88px);
    }

    .keep-visual {
        display: flex;
        justify-content: center;
    }

    /* A side panel is a column a few hundred pixels wide. */
    .keep-visual > :global(.iw-shot) {
        width: min(420px, 100%);
    }

    .keep-info {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .keep-title {
        font-size: clamp(1.5rem, 2.4vw, 2rem);
        line-height: 1.2;
        font-weight: 750;
        color: var(--text-color);
    }

    .keep-lead {
        font-size: 1.02rem;
        line-height: 1.65;
        color: var(--text-soft);
    }

    .keep-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        list-style: none;
        padding: 0;
    }

    .keep-list li {
        position: relative;
        padding-left: 22px;
        font-size: 0.94rem;
        line-height: 1.6;
        color: var(--text-muted);
    }

    .keep-list li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.6em;
        width: 8px;
        height: 8px;
        border-radius: 2px;
        background: var(--action-color);
    }

    :root[data-theme='light'] .keep-list li::before {
        background: var(--header-color);
    }

    @media (max-width: 900px) {
        .keep-row,
        .keep-row.reversed {
            grid-template-columns: 1fr;
            gap: 28px;
        }

        /* Stacked, the copy always comes first: the panel is the illustration. */
        .keep-row.reversed .keep-info {
            order: -1;
        }
    }
</style>
