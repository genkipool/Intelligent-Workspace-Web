---
import { useTranslations, localisePath } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import { site } from '@/data/site';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// Rendered at build time, so this is the year the site was deployed rather than the
// year the reader is in. Redeploy annually, or accept the drift — it beats shipping
// JavaScript for a number nobody reads.
const year = new Date().getFullYear();
---

<footer class="wrap">
    <p>© {year} {site.owner} · {site.name}</p>
    <nav>
        <a href={localisePath(lang, '/pay')}>{t('donate.cta')}</a>
        <a href={site.storeUrl} rel="noopener">{t('footer.store')}</a>
    </nav>
</footer>

<style>
/* ── Footer ────────────────────────────────────────────────────── */

footer {
    padding-block: clamp(28px, 3.5vw, 44px);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    font-size: 0.85rem;
    color: var(--muted);
}

footer nav {
    display: flex;
    gap: 22px;
}

footer a {
    color: var(--muted);
    text-decoration: none;
}

footer a:hover {
    color: var(--ink);
}
</style>
