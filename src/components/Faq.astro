---
import { type Lang } from '@/i18n/ui';
import SectionHeader from '@/components/SectionHeader.astro';
import QuestionList from '@/components/QuestionList.astro';
import { questions } from '@/data/story';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
---

<section id="faq" class="section-container wrap">
    <SectionHeader lang={lang} titleKey="faq.heading" subtitleKey="faq.subtitle" />
    <QuestionList lang={lang} items={questions} />
</section>
