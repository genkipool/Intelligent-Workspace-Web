---
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import SectionHeader from '@/components/SectionHeader.astro';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const comparisonItems = [
    {
        feature: t('comp.r1.feature'),
        standard: t('comp.r1.standard'),
        iw: t('comp.r1.iw'),
    },
    {
        feature: t('comp.r2.feature'),
        standard: t('comp.r2.standard'),
        iw: t('comp.r2.iw'),
    },
    {
        feature: t('comp.r3.feature'),
        standard: t('comp.r3.standard'),
        iw: t('comp.r3.iw'),
    },
    {
        feature: t('comp.r4.feature'),
        standard: t('comp.r4.standard'),
        iw: t('comp.r4.iw'),
    },
    {
        feature: t('comp.r5.feature'),
        standard: t('comp.r5.standard'),
        iw: t('comp.r5.iw'),
    },
    {
        feature: t('comp.r6.feature'),
        standard: t('comp.r6.standard'),
        iw: t('comp.r6.iw'),
    },
    {
        feature: t('comp.r7.feature'),
        standard: t('comp.r7.standard'),
        iw: t('comp.r7.iw'),
    },
];
---

<section id="comparativa" class="section-container wrap">
    <SectionHeader lang={lang} eyebrowKey="comp.eyebrow" titleKey="comp.title" subtitleKey="comp.subtitle" />

    <!-- Side-by-Side Dual Deck Architectural Comparison -->
    <div class="comparison-deck" data-reveal>
        <!-- Deck 1: Traditional Browsing / 15+ Fragmented Extensions -->
        <div class="deck-card traditional-deck">
            <div class="deck-header">
                <span class="deck-eyebrow bad">{t('comp.colStandard')}</span>
                <h3 class="deck-title">{t('comp.deck.badTitle')}</h3>
                <p class="deck-desc">{t('comp.deck.badDesc')}</p>
            </div>

            <div class="deck-items-list">
                {
                    comparisonItems.map((item) => (
                        <div class="deck-row-item">
                            <span class="status-cross-icon" aria-hidden="true">
                                ✕
                            </span>
                            <div class="row-text-block">
                                <span class="row-feature-name">{item.feature}</span>
                                <p class="row-feature-desc">{item.standard}</p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Deck 2: Intelligent Workspace (Viridian Engine) -->
        <div class="deck-card iw-deck">
            <div class="deck-header">
                <span class="deck-eyebrow good">{t('comp.colIw')}</span>
                <h3 class="deck-title text-gradient">{t('comp.deck.goodTitle')}</h3>
                <p class="deck-desc">{t('comp.deck.goodDesc')}</p>
            </div>

            <div class="deck-items-list">
                {
                    comparisonItems.map((item) => (
                        <div class="deck-row-item highlight">
                            <span class="status-check-icon" aria-hidden="true">
                                ✓
                            </span>
                            <div class="row-text-block">
                                <span class="row-feature-name">{item.feature}</span>
                                <p class="row-feature-desc">{item.iw}</p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .comparison-deck {
        display: grid;
        grid-template-columns: 1fr 1.15fr;
        gap: clamp(24px, 4vw, 44px);
        align-items: stretch;
    }

    .deck-card {
        border-radius: var(--radius-lg);
        padding: clamp(28px, 4vw, 44px);
        display: flex;
        flex-direction: column;
        gap: 24px;
        position: relative;
    }

    /* Traditional Deck (Muted / Subdued) */
    .traditional-deck {
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    :root[data-theme='light'] .traditional-deck {
        background: #fbfdfc;
        border: 1px solid var(--border-subtle);
        box-shadow: 0 4px 16px rgba(11, 28, 21, 0.04);
    }

    /* Intelligent Workspace Deck (Prominent & Illuminated) */
    .iw-deck {
        background: var(--bg-panel-color);
        border: 1.5px solid var(--action-color);
        box-shadow:
            0 12px 40px rgba(0, 0, 0, 0.25),
            0 0 24px rgba(22, 160, 133, 0.15);
    }

    :root[data-theme='light'] .iw-deck {
        background: #ffffff;
        border: 1.5px solid #16a085;
        box-shadow:
            0 12px 32px rgba(11, 28, 21, 0.08),
            0 0 20px rgba(22, 160, 133, 0.1);
    }

    .deck-header {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--border-subtle);
    }

    .deck-eyebrow {
        font-size: 0.76rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .deck-eyebrow.bad {
        color: #e74c3c;
    }

    :root[data-theme='light'] .deck-eyebrow.bad {
        color: #c0392b;
    }

    .deck-eyebrow.good {
        color: var(--action-color);
    }

    :root[data-theme='light'] .deck-eyebrow.good {
        color: var(--header-color);
    }

    .deck-title {
        font-size: clamp(1.3rem, 2vw, 1.6rem);
        font-weight: 750;
        color: var(--text-color);
    }

    .deck-desc {
        font-size: 0.92rem;
        color: var(--text-muted);
        line-height: 1.55;
    }

    .deck-items-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .deck-row-item {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 10px 12px;
        border-radius: 8px;
        background: rgba(0, 0, 0, 0.1);
    }

    :root[data-theme='light'] .deck-row-item {
        background: #f4f8f5;
    }

    .deck-row-item.highlight {
        background: rgba(22, 160, 133, 0.08);
        border: 1px solid rgba(22, 160, 133, 0.2);
    }

    :root[data-theme='light'] .deck-row-item.highlight {
        background: #eaf5f0;
        border: 1px solid #c0d8ce;
    }

    .status-cross-icon {
        color: #e74c3c;
        font-weight: 800;
        font-size: 0.95rem;
        line-height: 1.4;
        flex-shrink: 0;
    }

    .status-check-icon {
        color: var(--action-color);
        font-weight: 800;
        font-size: 1.1rem;
        line-height: 1.3;
        flex-shrink: 0;
    }

    :root[data-theme='light'] .status-check-icon {
        color: var(--header-color);
    }

    .row-text-block {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .row-feature-name {
        font-size: 0.8rem;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-muted);
    }

    :root[data-theme='light'] .row-feature-name {
        color: var(--text-dim);
    }

    .row-feature-desc {
        font-size: 0.9rem;
        color: var(--text-soft);
        line-height: 1.5;
    }

    @media (max-width: 900px) {
        .comparison-deck {
            grid-template-columns: 1fr;
        }
    }
</style>
