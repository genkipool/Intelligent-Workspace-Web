---
/**
 * Why an extension that asks for twenty-three permissions is still safe to install.
 *
 * Hiding the number would be the wrong answer — Chrome shows it at install time anyway.
 * Naming each group and the feature that cannot exist without it lets a reader check the
 * claim against chrome://extensions instead of taking it on faith.
 */
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import { grants, permissionCount } from '@/data/trust';
import { site } from '@/data/site';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const lede = t('trust.lede').replace('{count}', String(permissionCount));
---

<section id="permissions" class="trust wrap">
    <h2 class="section-head">{t('trust.heading')}</h2>
    <p class="trust-lede">{lede}</p>

    <dl class="grants">
        {
            grants.map((grant) => (
                <div class="grant">
                    <dt>
                        {grant.permissions.map((permission) => (
                            <code>{permission}</code>
                        ))}
                    </dt>
                    <dd>{t(grant.forKey)}</dd>
                </div>
            ))
        }
    </dl>

    <p class="trust-source">
        {t('trust.source')}
        <a href={site.sourceUrl} rel="noopener">
            {t('trust.sourceCta')}
            <span class="arrow" aria-hidden="true">→</span>
        </a>
    </p>
</section>

<style>
    .trust {
        padding-block: clamp(64px, 9vw, 120px);
        display: flex;
        flex-direction: column;
        gap: clamp(18px, 2.4vw, 28px);
    }

    .trust-lede {
        font-size: clamp(17px, 1.4vw, 20px);
        color: var(--ink-soft);
        max-width: 60ch;
    }

    .grants {
        margin: clamp(8px, 1.5vw, 16px) 0 0;
        display: flex;
        flex-direction: column;
    }

    .grant {
        display: grid;
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
        gap: clamp(18px, 3vw, 44px);
        align-items: baseline;
        padding-block: clamp(14px, 1.8vw, 20px);
        border-block-start: 1px solid var(--hair);
    }

    dt {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    code {
        font-family: var(--mono);
        font-size: 12.5px;
        color: var(--accent);
        background: color-mix(in srgb, var(--accent) 10%, transparent);
        padding: 3px 7px;
        border-radius: 5px;
    }

    dd {
        margin: 0;
        font-size: 15.5px;
        color: var(--ink-soft);
    }

    .trust-source {
        margin-block-start: clamp(14px, 2vw, 22px);
        font-size: 15.5px;
        color: var(--muted);
    }

    .trust-source a {
        color: var(--accent);
        text-decoration: none;
        white-space: nowrap;
    }

    .trust-source .arrow {
        display: inline-block;
        transition: transform 0.18s ease;
    }

    .trust-source a:hover .arrow {
        transform: translateX(4px);
    }

    @media (max-width: 760px) {
        .grant {
            grid-template-columns: minmax(0, 1fr);
            gap: 8px;
        }
    }
</style>
