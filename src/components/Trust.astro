---
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import type { IconName } from '@/data/icons';
import SectionHeader from '@/components/SectionHeader.astro';
import { grants, permissionCount } from '@/data/trust';
import { site } from '@/data/site';
import Icon from '@/components/Icon.astro';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const lede = t('trust.lede').replace('{count}', String(permissionCount));

const trustCards: readonly { icon: IconName; title: string; desc: string }[] = [
    {
        icon: 'lock',
        title: t('trust.card1.title'),
        desc: t('trust.card1.desc'),
    },
    {
        icon: 'key',
        title: t('trust.card2.title'),
        desc: t('trust.card2.desc'),
    },
    {
        icon: 'shield',
        title: t('trust.card3.title'),
        desc: t('trust.card3.desc'),
    },
];
---

<section id="privacidad" class="section-container wrap">
    <!-- Section Header (No Pill Badge) -->
    <SectionHeader lang={lang} titleKey="trust.heading" subtitle={lede} />

    <!-- 3 Core Privacy Pillars -->
    <div class="trust-cards-grid" data-reveal>
        {
            trustCards.map((card) => (
                <div class="glass-card">
                    <div class="trust-icon-box">
                        <Icon name={card.icon} size={22} />
                    </div>
                    <h3 class="trust-card-title">{card.title}</h3>
                    <p class="trust-card-desc">{card.desc}</p>
                </div>
            ))
        }
    </div>

    <!-- Permissions Breakdown Table -->
    <div class="permissions-matrix" data-reveal>
        <div class="matrix-header">
            <span>{t('trust.colPermissions')}</span>
            <span>{t('trust.colPurpose')}</span>
        </div>
        {
            grants.map((grant) => (
                <div class="matrix-row">
                    <div class="grant-tags">
                        {grant.permissions.map((p) => (
                            <code class="perm-tag">{p}</code>
                        ))}
                    </div>
                    <div class="grant-reason">{t(grant.forKey)}</div>
                </div>
            ))
        }
        <div class="matrix-footer">
            <span>{t('trust.source')}</span>
            <a
                href={site.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary source-btn"
            >
                <Icon name="github" size={16} />
                <span>{t('trust.sourceCta')}</span>
            </a>
        </div>
    </div>
</section>

<style>
    .trust-cards-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-bottom: 32px;
    }

    .trust-icon-box {
        margin-bottom: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: rgba(22, 160, 133, 0.15);
        color: var(--action-color);
        border: 1px solid rgba(26, 188, 156, 0.3);
    }

    :root[data-theme='light'] .trust-icon-box {
        background: #edf6f2;
        border: 1px solid #b8dacb;
        color: var(--header-color);
        box-shadow: 0 2px 8px rgba(22, 160, 133, 0.08);
    }

    .trust-card-title {
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 8px;
        color: var(--text-color);
    }

    .trust-card-desc {
        font-size: 0.94rem;
        color: var(--text-soft);
        line-height: 1.6;
    }

    .permissions-matrix {
        background: var(--bg-panel-color);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    }

    :root[data-theme='light'] .permissions-matrix {
        background: #ffffff;
        box-shadow: 0 4px 16px rgba(12, 29, 23, 0.05);
    }

    .matrix-header {
        display: grid;
        grid-template-columns: 1.4fr 2fr;
        padding: 14px 20px;
        background: rgba(35, 50, 64, 0.5);
        border-bottom: 1px solid var(--border-color);
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-muted);
    }

    :root[data-theme='light'] .matrix-header {
        background: var(--bg-surface);
        border-bottom: 1px solid #d1ded8;
        color: #0c1d17;
    }

    .matrix-row {
        display: grid;
        grid-template-columns: 1.4fr 2fr;
        padding: 16px 20px;
        border-bottom: 1px solid var(--border-subtle);
        align-items: center;
        gap: 16px;
        font-size: 0.92rem;
    }

    .matrix-row:hover {
        background: var(--bg-card-hover);
    }

    .grant-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .perm-tag {
        font-family: var(--font-mono);
        font-size: 0.76rem;
        padding: 3px 8px;
        border-radius: 4px;
        background: rgba(22, 160, 133, 0.12);
        color: var(--action-color);
        border: 1px solid rgba(22, 160, 133, 0.3);
    }

    :root[data-theme='light'] .perm-tag {
        background: #edf6f2;
        color: #0a5745;
        border: 1px solid #b8dacb;
        font-weight: 600;
    }

    .grant-reason {
        color: var(--text-soft);
        line-height: 1.5;
    }

    .matrix-footer {
        padding: 18px 20px;
        background: var(--bg-surface);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        font-size: 0.9rem;
        color: var(--text-muted);
    }

    :root[data-theme='light'] .matrix-footer {
        background: var(--bg-color);
    }

    .source-btn {
        padding: 8px 18px;
        font-size: 0.85rem;
    }

    @media (max-width: 850px) {
        .trust-cards-grid {
            grid-template-columns: 1fr;
        }

        .matrix-header {
            display: none;
        }

        .matrix-row {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .matrix-footer {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
