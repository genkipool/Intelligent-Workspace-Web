---
/**
 * The donation form, rendered once for both languages.
 *
 * WHY THIS IS A WEB PAGE AND NOT PART OF THE EXTENSION: Manifest V3 pins an extension's
 * script-src to 'self', so Stripe.js cannot load in a panel page. This is an ordinary
 * page, so it can — and the extension's side panel frames it.
 *
 * The copy is rendered at build time, so the sheet reads correctly before any script
 * runs. `pay.ts` only wires up Stripe.
 */
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { donationAmounts } from '@/data/site';
import { CARD_FORM_METHODS, CARD_FORM_METHOD_LABEL } from '@/lib/donation';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<main class="sheet" aria-labelledby="sheet-title">
    <h1 id="sheet-title">{t('pay.title')}</h1>

    <fieldset class="amounts">
        <legend>{t('pay.chooseAmount')}</legend>
        <div class="chips" id="chips" role="radiogroup" aria-labelledby="sheet-title">
            {
                donationAmounts.map((amount) => (
                    <button type="button" class="chip" data-amount={amount} role="radio" aria-checked="false">
                        {amount}
                    </button>
                ))
            }
        </div>
        <label class="custom">
            <span>{t('pay.otherAmount')}</span>
            <div class="field">
                <span class="symbol" aria-hidden="true">€</span>
                <input
                    id="custom-amount"
                    type="number"
                    inputmode="decimal"
                    min="1"
                    max="500"
                    step="1"
                    autocomplete="off"
                />
            </div>
        </label>
    </fieldset>

    <div id="express" class="express" hidden></div>
    <p class="divider" id="divider" hidden><span>{t('pay.orCard')}</span></p>

    <form id="payment-form" novalidate>
        <!--
            Shown until Stripe's Elements report themselves ready. Cold, that takes
            seconds — the frame has to fetch `js.stripe.com/v3` and stand up three more
            frames behind it — and an empty gap above a greyed-out button is
            indistinguishable from a page that failed. This says which of the two it is.
        -->
        <div id="payment-loading" class="loading" role="status">
            <span class="loading-spinner" aria-hidden="true"></span>
            <span>{t('pay.loading')}</span>
        </div>
        <div id="payment-element"></div>
        <button id="submit" type="submit" disabled>
            <span class="spinner" aria-hidden="true"></span>
            <span id="submit-label">{t('pay.donateNow')}</span>
        </button>
    </form>

    <!--
        WHAT THE PANEL GETS INSTEAD OF THE CARD FORM.

        Chrome decides whether a payment form is in a secure context from the URL of the
        TOP-LEVEL document, not from the frame the fields are in
        (`ChromeAutofillClient::IsContextSecure` reads `GetVisibleEntry()`). The panel's
        top-level document is `chrome-extension://…`, whose scheme is not cryptographic,
        so every card field framed in it is judged insecure and anyone with a saved card
        is told the form "does not use a secure connection". Nothing this page sends —
        headers, HTTPS, CSP — can change that verdict from inside the panel.

        So the panel does not draw card fields at all. It draws these, and each one opens
        the same sheet in a window of its own, where the top-level document IS https and
        the verdict flips. `pay.ts` decides which of the two blocks is shown; the buttons
        come from `CARD_FORM_METHODS`, so this list cannot drift from the one the card
        form and the PaymentIntent are built from.
    -->
    <div id="handoff" class="handoff" hidden>
        {
            CARD_FORM_METHODS.map((method) => (
                <button type="button" class="handoff-option" data-method={method}>
                    <span>{t(CARD_FORM_METHOD_LABEL[method])}</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path
                            d="M14 4h6v6M20 4l-8.5 8.5M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </svg>
                </button>
            ))
        }
    </div>
    <p class="fineprint" id="handoff-note" hidden>{t('pay.opensInWindow')}</p>

    <p id="status" class="status" role="status" aria-live="polite"></p>
    <p class="fineprint" id="wallet-note" hidden>{t('pay.walletUnavailable')}</p>
    <p class="fineprint">{t('pay.secured')}</p>
</main>

<!-- Strings the client script needs. Read from the DOM rather than duplicated in
     TypeScript, so the dictionary stays the only place copy lives. -->
<script
    type="application/json"
    id="pay-strings"
    is:inline
    set:html={JSON.stringify({
        donateNow: t('pay.donateNow'),
        failed: t('pay.failed'),
        badAmount: t('pay.badAmount'),
        opensOutside: t('pay.opensOutside'),
    })}
/>
