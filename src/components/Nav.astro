---
import { Image } from 'astro:assets';
import { useTranslations, localisePath } from '@/i18n/utils';
import logo from '@/assets/logo.png';
import type { Lang } from '@/i18n/ui';
import { site } from '@/data/site';
import ThemeToggle from '@/components/ThemeToggle.astro';
import LangToggle from '@/components/LangToggle.astro';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="nav wrap">
    <a class="brand" href={localisePath(lang, '/')}>
        <Image src={logo} alt="" width={52} height={52} class="brand-mark" loading="eager" />
        <span>{site.name}</span>
    </a>
    <nav>
        <a href="#what">{t('nav.what')}</a>
        <a href="#inside">{t('caps.heading')}</a>
        <a href="#keyboard">{t('nav.keyboard')}</a>
        <a href="#privacy">{t('nav.privacy')}</a>
    </nav>
    <div class="controls">
        <ThemeToggle lang={lang} />
        <LangToggle lang={lang} />
    </div>
</header>

<style>
    /* The switcher is a link, not a button: it navigates to a real URL, so it works
       with JavaScript off and search engines can follow it. */

    .nav {
        /* Published as a custom property so the hero can subtract it from 100svh and
           still fill exactly one screen. Guessing this number is how a hero ends up
           76px too tall and forces a scroll. */
        --nav-height: 76px;
        min-height: var(--nav-height);
        display: flex;
        align-items: center;
        gap: clamp(16px, 3vw, 40px);
        padding-block: clamp(20px, 2.4vw, 30px);
    }

    .brand-mark {
        /* Drawn at 2x and displayed at 26 so it stays crisp on a retina screen. */
        width: 26px;
        height: 26px;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 0.9rem;
        font-weight: 620;
        letter-spacing: -0.012em;
        text-decoration: none;
        color: var(--band-ink);
        white-space: nowrap;
    }

    .nav nav {
        margin-inline-start: auto;
        display: flex;
        gap: clamp(14px, 2vw, 30px);
        font-size: 0.88rem;
    }

    .nav nav a {
        color: var(--band-soft);
        text-decoration: none;
        transition: color 0.16s ease;
    }

    .nav nav a:hover {
        color: var(--band-ink);
    }

    .controls {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }
</style>
