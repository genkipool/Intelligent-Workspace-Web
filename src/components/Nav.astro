---
import { useTranslations, localisePath } from '@/i18n/utils';
import type { Lang, TranslationKey } from '@/i18n/ui';
import { site } from '@/data/site';
import LangToggle from '@/components/LangToggle.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import Icon from '@/components/Icon.astro';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homeUrl = localisePath(lang, '/');

/**
 * The donation sheet is a page of its own, not a section of this one, which is why it
 * is an action beside the install button rather than a sixth entry in `links` below —
 * everything in that list scrolls, and this one leaves.
 *
 * `localisePath`, so a Spanish reader gets `/es/pay` and a sheet already in Spanish.
 */
const payUrl = localisePath(lang, '/pay');

/**
 * The bar and the drawer are the same five links, so they are one list. They were two
 * copies of the same markup, which is exactly the kind of pair that drifts: a section
 * added to one and forgotten in the other is invisible until someone opens the site on
 * a phone.
 */
const links: readonly { href: string; labelKey: TranslationKey }[] = [
    { href: '#pilares', labelKey: 'nav.features' },
    { href: '#navaja-suiza', labelKey: 'nav.tools' },
    { href: '#comparativa', labelKey: 'comp.badge' },
    { href: '#privacidad', labelKey: 'nav.privacy' },
    { href: '#faq', labelKey: 'nav.faq' },
];
---

<header class="site-header" id="top">
    <div class="header-inner wrap">
        <!-- Brand identity with seamless Extension Logo -->
        <a href={homeUrl} class="brand-link" id="nav-brand-logo">
            <img
                src="/assets/logo-64.png"
                alt=""
                width="32"
                height="32"
                class="brand-logo-img"
                fetchpriority="high"
                decoding="async"
            />
            <div class="brand-text-block">
                <span class="brand-name">Intelligent Workspace</span>
                <span class="version-tag">{t('nav.version')}</span>
            </div>
        </a>

        <!-- Desktop Navigation Links (Clean & Essential) -->
        <nav class="nav-links" aria-label="Main Navigation">
            {
                links.map((link) => (
                    <a href={link.href} class="nav-item">
                        {t(link.labelKey)}
                    </a>
                ))
            }
        </nav>

        <!-- Right Side Controls & CTA -->
        <div class="nav-actions">
            <LangToggle lang={lang} />
            <ThemeToggle lang={lang} />

            <!--
                `data-astro-reload` is not optional. The site navigates with the view
                transitions router, and `/pay` is served with a strict CSP of its own so
                that Stripe can be framed there and nowhere else; swapped in as a
                fragment it would inherit this page's policy instead and the sheet would
                come up blank. `DonateBand` does the same for the same reason.
            -->
            <a
                href={payUrl}
                class="btn-secondary nav-donate-btn"
                title={t('nav.donateTitle')}
                aria-label={t('nav.donate')}
                data-astro-reload
            >
                <Icon name="heart" size={16} />
                <span>{t('nav.donate')}</span>
            </a>

            <a
                href={site.storeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary nav-install-btn"
            >
                <Icon name="chromeStore" size={18} />
                <span>{t('nav.install')}</span>
            </a>

            <!-- Mobile Hamburger Toggle -->
            <button
                id="mobile-menu-btn"
                type="button"
                class="mobile-toggle-btn"
                aria-label="Toggle navigation menu"
                aria-expanded="false"
            >
                <Icon name="menu" size={22} class="icon-open" />
                <Icon name="close" size={22} class="icon-close" />
            </button>
        </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div id="mobile-drawer" class="mobile-drawer">
        <div class="mobile-drawer-inner">
            {
                links.map((link) => (
                    <a href={link.href} class="mobile-link">
                        {t(link.labelKey)}
                    </a>
                ))
            }
            <div class="mobile-drawer-cta">
                <a href={site.storeUrl} target="_blank" rel="noopener noreferrer" class="btn-primary w-full">
                    {t('nav.install')}
                </a>
                <!-- Second, because installing is what most readers came for. -->
                <a href={payUrl} class="btn-secondary w-full mobile-donate-link" data-astro-reload>
                    <Icon name="heart" size={16} />
                    <span>{t('nav.donate')}</span>
                </a>
            </div>
        </div>
    </div>
</header>

<script>
    function initNavHandlers() {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const drawer = document.getElementById('mobile-drawer');
        const mobileLinks = document.querySelectorAll('.mobile-link');
        const brandLink = document.getElementById('nav-brand-logo');

        /*
         * ONCE PER SET OF NODES, NOT ONCE PER CALL.
         *
         * This runs twice on every first load: once at module scope, and again on
         * `astro:page-load`, which the view transitions router fires for the initial
         * page as well as for later ones. Both calls bound their own handler to the
         * same button, so one press opened the drawer and closed it again in the same
         * tick — measured, two `is-open` writes per click — and the menu simply never
         * appeared on a phone. Nothing in the markup said so, because the class was
         * being set correctly; it was just being unset immediately afterwards.
         *
         * The flag lives on the node rather than in a module variable on purpose: after
         * a transition these are new elements, so the mark is gone and they get wired,
         * which is exactly what the `astro:page-load` call is for.
         */
        if (!menuBtn || menuBtn.dataset.navWired === 'true') return;
        menuBtn.dataset.navWired = 'true';

        function toggleMenu() {
            const isOpen = drawer?.classList.contains('is-open');
            if (isOpen) {
                drawer?.classList.remove('is-open');
                menuBtn?.setAttribute('aria-expanded', 'false');
            } else {
                drawer?.classList.add('is-open');
                menuBtn?.setAttribute('aria-expanded', 'true');
            }
        }

        menuBtn?.addEventListener('click', toggleMenu);
        mobileLinks.forEach((link) => {
            link.addEventListener('click', () => {
                drawer?.classList.remove('is-open');
                menuBtn?.setAttribute('aria-expanded', 'false');
            });
        });

        // Logo click smooth scroll to top
        brandLink?.addEventListener('click', (e) => {
            const path = window.location.pathname;
            const isHome = path === '/' || path === '/es/' || path === '/es';
            if (isHome) {
                e.preventDefault();
                window.scrollTo({ top: 0, behavior: 'smooth' });
                history.pushState(null, '', path);
            }
        });
    }

    initNavHandlers();
    document.addEventListener('astro:page-load', initNavHandlers);
</script>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        width: 100%;
        background: rgba(27, 38, 49, 0.92);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border-color);
        transition:
            background-color 0.2s ease,
            border-color 0.2s ease;
    }

    :root[data-theme='light'] .site-header {
        background: rgba(255, 255, 255, 0.94);
        border-bottom: 1px solid var(--border-color);
    }

    .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        height: 70px;
    }

    .brand-link {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: var(--text-color);
        flex-shrink: 0;
        cursor: pointer;
    }

    .brand-logo-img {
        width: 32px;
        height: 32px;
        object-fit: contain;
        display: block;
    }

    .brand-text-block {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
    }

    .brand-name {
        font-weight: 750;
        font-size: 1.05rem;
        letter-spacing: -0.02em;
        color: var(--text-color);
    }

    .version-tag {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--action-color);
        letter-spacing: 0.02em;
    }

    :root[data-theme='light'] .version-tag {
        color: var(--header-color);
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .nav-item {
        padding: 8px 14px;
        border-radius: var(--radius-full);
        font-size: 0.9rem;
        font-weight: 550;
        color: var(--text-muted);
        text-decoration: none;
        transition: all 0.18s ease;
    }

    .nav-item:hover {
        color: var(--text-color);
        background: var(--bg-card-hover);
    }

    :root[data-theme='light'] .nav-item:hover {
        color: var(--text-color);
        background: var(--bg-surface);
    }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .nav-install-btn {
        padding: 9px 20px;
        font-size: 0.88rem;
        min-width: unset;
        min-height: unset;
    }

    /* The same treatment `.nav-install-btn` gives `.btn-primary`: the shared button is
       sized for a page's call to action, and a 50px-tall pill in a 70px bar leaves no
       bar. Secondary rather than primary on purpose — there is one primary action up
       here, and it is installing. */
    /*
     * A FIXED WIDTH, NOT ONE THE LABEL DECIDES.
     *
     * `.btn-secondary` sizes itself to its content, which means this button is 105px in
     * English and 98px in Spanish — the bar shifts under the language switch, and it
     * would shift again for any third language. It is a fixed control in a fixed bar,
     * so the width is stated here and the label is centred in it. The room is set for
     * the longer of the two labels plus its heart, with a little to spare.
     *
     * `.nav-install-btn` gives `.btn-primary` the same treatment for the same reason:
     * the shared button is sized for a page's call to action, and a 50px-tall pill in a
     * 70px bar leaves no bar. Secondary rather than primary on purpose — there is one
     * primary action up here, and it is installing.
     */
    .nav-donate-btn {
        width: 116px;
        /* Fixed means fixed: without this the flex row squeezes it as the window
           narrows, so the button that was not supposed to move with its label moves
           with the viewport instead. */
        flex-shrink: 0;
        padding: 8px 0;
        justify-content: center;
        font-size: 0.88rem;
        min-width: unset;
        min-height: unset;
        gap: 7px;
        box-shadow: none;
    }

    .mobile-toggle-btn {
        display: none;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        background: var(--bg-panel-color);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        color: var(--text-color);
        cursor: pointer;
    }

    :root[data-theme='light'] .mobile-toggle-btn {
        background: #ffffff;
        border-color: var(--border-color);
        color: var(--text-color);
    }

    :root[data-theme='light'] .mobile-toggle-btn:hover {
        background: var(--bg-card-hover);
        border-color: #16a085;
        color: var(--header-color);
    }

    /* `:global` because the glyph is rendered by `Icon.astro`, so it carries that
       component's scope and not this one's. Astro scopes every part of a selector, and
       an unscoped element here would otherwise never be matched. */
    .mobile-toggle-btn :global(.icon-close),
    .mobile-toggle-btn[aria-expanded='true'] :global(.icon-open) {
        display: none;
    }

    .mobile-toggle-btn[aria-expanded='true'] :global(.icon-close) {
        display: block;
    }

    .mobile-drawer {
        display: none;
        position: absolute;
        top: 70px;
        left: 0;
        right: 0;
        background: var(--bg-panel-color);
        border-bottom: 1px solid var(--border-color);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
        padding: 20px var(--gutter);
        z-index: 60;
    }

    :root[data-theme='light'] .mobile-drawer {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border-color);
        box-shadow: 0 16px 40px rgba(11, 28, 21, 0.08);
    }

    .mobile-drawer.is-open {
        display: block;
    }

    .mobile-drawer-inner {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-width: var(--measure);
        margin: 0 auto;
    }

    .mobile-link {
        padding: 10px 14px;
        border-radius: var(--radius-sm);
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-color);
        transition: background 0.15s;
    }

    .mobile-link:hover {
        background: var(--bg-card-hover);
        color: var(--action-color);
    }

    :root[data-theme='light'] .mobile-link:hover {
        background: var(--bg-card-hover);
        color: var(--header-color);
    }

    .mobile-drawer-cta {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 8px;
        padding-top: 14px;
        border-top: 1px solid var(--border-subtle);
    }

    .mobile-donate-link {
        min-height: 46px;
        font-size: 0.95rem;
    }

    .w-full {
        width: 100%;
    }

    /*
     * THE BAR IS SIX THINGS WIDE, AND UNDER ABOUT 1280px IT STOPS BEING SIX THINGS WIDE.
     *
     * Measured: the full bar needs 1280px to seat the install button inside the window.
     * Below that it used to simply overflow — and it did so before this donate link
     * existed too, from roughly 1150px down to the 920px breakpoint, with "Add to
     * Chrome" pushed off the right-hand edge and no way to reach it. Nothing said so,
     * because an overflowing flex row neither wraps nor scrolls; it just leaves.
     *
     * So there are two steps now instead of one. First the row is tightened: the donate
     * button drops to its heart, which is what an icon is for, and the links give back
     * the padding they can spare. Then, when even that does not fit, the whole thing
     * folds into the drawer — at 1120px rather than 920, because 920 was a promise the
     * bar could not keep.
     */
    @media (max-width: 1360px) {
        .nav-item {
            padding: 8px 10px;
        }

        .nav-links {
            gap: 4px;
        }

        .nav-actions {
            gap: 8px;
        }
    }

    @media (max-width: 1230px) {
        .nav-links {
            display: none;
        }

        .nav-install-btn,
        .nav-donate-btn {
            display: none;
        }

        .mobile-toggle-btn {
            display: flex;
        }
    }
</style>
