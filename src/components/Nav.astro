---
import { useTranslations, localisePath } from '@/i18n/utils';
import type { Lang, TranslationKey } from '@/i18n/ui';
import { site } from '@/data/site';
import LangToggle from '@/components/LangToggle.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import Icon from '@/components/Icon.astro';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homeUrl = localisePath(lang, '/');

/**
 * The contribution sheet is a page of its own, not a section of this one, which is why it
 * is an action beside the install button rather than a sixth entry in `links` below —
 * everything in that list scrolls, and this one leaves.
 *
 * `localisePath`, so a Spanish reader gets `/es/pay` and a sheet already in Spanish.
 */
const payUrl = localisePath(lang, '/pay');

/**
 * The bar and the drawer are the same five links, so they are one list. They were two
 * copies of the same markup, which is exactly the kind of pair that drifts: a section
 * added to one and forgotten in the other is invisible until someone opens the site on
 * a phone.
 */
const links: readonly { href: string; labelKey: TranslationKey }[] = [
    { href: '#pilares', labelKey: 'nav.features' },
    { href: '#navaja-suiza', labelKey: 'nav.tools' },
    { href: '#comparativa', labelKey: 'comp.badge' },
    { href: '#privacidad', labelKey: 'nav.privacy' },
    { href: '#faq', labelKey: 'nav.faq' },
];
---

<header class="site-header" id="top">
    <div class="header-inner wrap">
        {/* Brand identity with seamless Extension Logo */}
        <a href={homeUrl} class="brand-link" id="nav-brand-logo">
            <img
                src="/assets/logo.svg"
                alt=""
                width="32"
                height="32"
                class="brand-logo-img"
                fetchpriority="high"
                decoding="async"
            />
            <div class="brand-text-block">
                <span class="brand-name">Intelligent Workspace</span>
                <span class="version-tag">{t('nav.version')}</span>
            </div>
        </a>

        {/* Desktop Navigation Links (Clean & Essential) */}
        <nav class="nav-links" aria-label="Main Navigation">
            {
                links.map((link) => (
                    <a href={link.href} class="nav-item">
                        {t(link.labelKey)}
                    </a>
                ))
            }
        </nav>

        {/* Right Side Controls & CTA */}
        <div class="nav-actions">
            <LangToggle lang={lang} />
            <ThemeToggle lang={lang} />

            {
                /*
                `data-astro-reload` is not optional. The site navigates with the view
                transitions router, and `/pay` is served with a strict CSP of its own so
                that Stripe can be framed there and nowhere else; swapped in as a
                fragment it would inherit this page's policy instead and the sheet would
                come up blank. `ContributionBand` does the same for the same reason.
            */
            }
            <a
                href={payUrl}
                class="btn-secondary nav-contribute-btn"
                title={t('nav.contributeTitle')}
                aria-label={t('nav.contribute')}
                data-astro-reload
            >
                <Icon name="heart" size={16} />
                <span>{t('nav.contribute')}</span>
            </a>

            <a
                href={site.storeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary nav-install-btn"
            >
                <Icon name="chromeStore" size={18} />
                <span>{t('nav.install')}</span>
            </a>

            {
                /*
                THREE BARS, NOT TWO ICONS.

                It used to be `<Icon name="menu">` and `<Icon name="close">` stacked, with
                `display` swapping which one showed: a hard cut between two unrelated
                glyphs at the exact moment the reader is looking straight at it. Bars can
                be moved instead — the outer two rotate onto each other and the middle one
                gets out of the way — so the same press reads as one thing becoming
                another. Nothing else can animate that: the sprite's lines live inside a
                `<use>` shadow tree and cannot be reached by a stylesheet.
            */
            }
            <button
                id="mobile-menu-btn"
                type="button"
                class="mobile-toggle-btn"
                aria-label={t('nav.menu')}
                aria-expanded="false"
                aria-controls="mobile-drawer"
            >
                <span class="burger" aria-hidden="true">
                    <span class="burger-bar"></span>
                    <span class="burger-bar"></span>
                    <span class="burger-bar"></span>
                </span>
            </button>
        </div>
    </div>

    {
        /*
        The page behind the drawer, dimmed. It is what makes the drawer read as being in
        front of something rather than as part of the header, and it is the target most
        people reach for to dismiss a menu.
    */
    }
    <div id="mobile-scrim" class="mobile-scrim" aria-hidden="true"></div>

    {/* Mobile Navigation Drawer */}
    <div id="mobile-drawer" class="mobile-drawer">
        <div class="mobile-drawer-inner">
            {
                links.map((link) => (
                    <a href={link.href} class="mobile-link">
                        {t(link.labelKey)}
                    </a>
                ))
            }
            <div class="mobile-drawer-cta">
                <a href={site.storeUrl} target="_blank" rel="noopener noreferrer" class="btn-primary w-full">
                    {t('nav.install')}
                </a>
                {/* Second, because installing is what most readers came for. */}
                <a href={payUrl} class="btn-secondary w-full mobile-contribute-link" data-astro-reload>
                    <Icon name="heart" size={16} />
                    <span>{t('nav.contribute')}</span>
                </a>
            </div>
        </div>
    </div>
</header>

<script>
    function initNavHandlers() {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const drawer = document.getElementById('mobile-drawer');
        const mobileLinks = document.querySelectorAll('.mobile-link');
        const brandLink = document.getElementById('nav-brand-logo');

        /*
         * ONCE PER SET OF NODES, NOT ONCE PER CALL.
         *
         * This runs twice on every first load: once at module scope, and again on
         * `astro:page-load`, which the view transitions router fires for the initial
         * page as well as for later ones. Both calls bound their own handler to the
         * same button, so one press opened the drawer and closed it again in the same
         * tick — measured, two `is-open` writes per click — and the menu simply never
         * appeared on a phone. Nothing in the markup said so, because the class was
         * being set correctly; it was just being unset immediately afterwards.
         *
         * The flag lives on the node rather than in a module variable on purpose: after
         * a transition these are new elements, so the mark is gone and they get wired,
         * which is exactly what the `astro:page-load` call is for.
         */
        if (!menuBtn || menuBtn.dataset.navWired === 'true') return;
        menuBtn.dataset.navWired = 'true';

        const scrim = document.getElementById('mobile-scrim');

        /*
         * One function that puts every part into the same state, rather than three
         * places each remembering to update the button, the drawer and the scrim. The
         * `aria-expanded` attribute is not bookkeeping here: it is what the CSS reads to
         * turn the bars into a cross, so the animation cannot fall out of step with the
         * menu.
         *
         * The page behind is frozen while the menu is over it. A drawer that scrolls the
         * document under itself is the oldest bug in mobile navigation, and one line
         * stops it.
         */
        function setMenu(open: boolean) {
            drawer?.classList.toggle('is-open', open);
            scrim?.classList.toggle('is-open', open);
            menuBtn?.setAttribute('aria-expanded', String(open));
            document.body.style.overflow = open ? 'hidden' : '';
        }

        const isOpen = () => drawer?.classList.contains('is-open') ?? false;

        menuBtn?.addEventListener('click', () => setMenu(!isOpen()));
        scrim?.addEventListener('click', () => setMenu(false));
        mobileLinks.forEach((link) => link.addEventListener('click', () => setMenu(false)));

        // Escape is what people press, and it has to reach the button afterwards or the
        // focus is left inside a drawer that is no longer on screen.
        document.addEventListener('keydown', (event) => {
            if (event.key !== 'Escape' || !isOpen()) return;
            setMenu(false);
            menuBtn?.focus();
        });

        /*
         * Widening the window past the breakpoint hides the button and the drawer with
         * it, but the state stays behind: the scroll lock would survive on a desktop
         * page with no visible way to undo it. The menu closes itself instead.
         */
        const wide = window.matchMedia('(min-width: 1231px)');
        wide.addEventListener('change', (event) => {
            if (event.matches) setMenu(false);
        });

        // Logo click smooth scroll to top
        brandLink?.addEventListener('click', (e) => {
            const path = window.location.pathname;
            const isHome = path === '/' || path === '/es/' || path === '/es';
            if (isHome) {
                e.preventDefault();
                window.scrollTo({ top: 0, behavior: 'smooth' });
                history.pushState(null, '', path);
            }
        });
    }

    initNavHandlers();
    document.addEventListener('astro:page-load', initNavHandlers);
</script>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        width: 100%;
        background: var(--header-veil);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border-color);
        transition:
            background-color 0.2s ease,
            border-color 0.2s ease;
    }

    .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        height: 70px;
    }

    .brand-link {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: var(--text-color);
        flex-shrink: 0;
        cursor: pointer;
    }

    .brand-logo-img {
        width: 32px;
        height: 32px;
        object-fit: contain;
        display: block;
    }

    .brand-text-block {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
    }

    .brand-name {
        font-weight: 750;
        font-size: 1.05rem;
        letter-spacing: -0.02em;
        color: var(--text-color);
    }

    .version-tag {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--action-color);
        letter-spacing: 0.02em;
    }

    :root[data-theme='light'] .version-tag {
        color: var(--header-color);
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .nav-item {
        padding: 8px 14px;
        border-radius: var(--radius-full);
        font-size: 0.9rem;
        font-weight: 550;
        color: var(--text-muted);
        text-decoration: none;
        transition: all 0.18s ease;
    }

    .nav-item:hover {
        color: var(--text-color);
        background: var(--bg-card-hover);
    }

    :root[data-theme='light'] .nav-item:hover {
        color: var(--text-color);
        background: var(--bg-surface);
    }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .nav-install-btn {
        padding: 9px 20px;
        font-size: 0.88rem;
        min-width: unset;
        min-height: unset;
    }

    /* The same treatment `.nav-install-btn` gives `.btn-primary`: the shared button is
       sized for a page's call to action, and a 50px-tall pill in a 70px bar leaves no
       bar. Secondary rather than primary on purpose — there is one primary action up
       here, and it is installing. */
    /*
     * A FIXED WIDTH, NOT ONE THE LABEL DECIDES.
     *
     * `.btn-secondary` sizes itself to its content, which means this button is 105px in
     * English and 98px in Spanish — the bar shifts under the language switch, and it
     * would shift again for any third language. It is a fixed control in a fixed bar,
     * so the width is stated here and the label is centred in it. The room is set for
     * the longer of the two labels plus its heart, with a little to spare.
     *
     * `.nav-install-btn` gives `.btn-primary` the same treatment for the same reason:
     * the shared button is sized for a page's call to action, and a 50px-tall pill in a
     * 70px bar leaves no bar. Secondary rather than primary on purpose — there is one
     * primary action up here, and it is installing.
     */
    .nav-contribute-btn {
        width: 116px;
        /* Fixed means fixed: without this the flex row squeezes it as the window
           narrows, so the button that was not supposed to move with its label moves
           with the viewport instead. */
        flex-shrink: 0;
        padding: 8px 0;
        justify-content: center;
        font-size: 0.88rem;
        min-width: unset;
        min-height: unset;
        gap: 7px;
        box-shadow: none;
    }

    .mobile-toggle-btn {
        display: none;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        background: var(--bg-panel-color);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        color: var(--text-color);
        cursor: pointer;
    }

    :root[data-theme='light'] .mobile-toggle-btn {
        background: #ffffff;
        border-color: var(--border-color);
        color: var(--text-color);
    }

    :root[data-theme='light'] .mobile-toggle-btn:hover {
        background: var(--bg-card-hover);
        border-color: #16a085;
        color: var(--header-color);
    }

    .mobile-toggle-btn:hover {
        border-color: var(--action-color);
    }

    .mobile-toggle-btn:focus-visible {
        outline: 2px solid var(--action-color);
        outline-offset: 2px;
    }

    /* --- THE BARS ---------------------------------------------------
       A fixed box so the three bars can be positioned against it and
       rotate about its centre; `transform` and `opacity` only, so the
       whole morph runs on the compositor and never touches layout. */
    .burger {
        position: relative;
        display: block;
        width: 18px;
        height: 14px;
    }

    .burger-bar {
        position: absolute;
        left: 0;
        width: 100%;
        height: 2px;
        border-radius: 2px;
        background: currentColor;
        transition:
            transform 0.32s cubic-bezier(0.65, 0, 0.35, 1),
            opacity 0.16s ease;
    }

    .burger-bar:nth-child(1) {
        top: 0;
    }

    .burger-bar:nth-child(2) {
        top: 6px;
    }

    .burger-bar:nth-child(3) {
        top: 12px;
    }

    /* The outer two travel to the middle and cross there; the one already in the middle
       fades as they arrive, so there is never a third line inside the X. */
    .mobile-toggle-btn[aria-expanded='true'] .burger-bar:nth-child(1) {
        transform: translateY(6px) rotate(45deg);
    }

    .mobile-toggle-btn[aria-expanded='true'] .burger-bar:nth-child(2) {
        opacity: 0;
        transform: scaleX(0.2);
    }

    .mobile-toggle-btn[aria-expanded='true'] .burger-bar:nth-child(3) {
        transform: translateY(-6px) rotate(-45deg);
    }

    /* --- THE SCRIM --------------------------------------------------
       Below the drawer and above everything else. It fades rather than
       appears, because a dark sheet that arrives in one frame reads as
       the page having broken. */
    .mobile-scrim {
        position: fixed;
        inset: 70px 0 0;
        background: rgba(11, 18, 24, 0.55);
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition:
            opacity 0.28s ease,
            visibility 0s linear 0.28s;
        z-index: 55;
    }

    :root[data-theme='light'] .mobile-scrim {
        background: rgba(11, 28, 21, 0.28);
    }

    .mobile-scrim.is-open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transition:
            opacity 0.28s ease,
            visibility 0s;
    }

    /*
     * `display` cannot be transitioned, and that is the whole reason this drawer used to
     * appear in one frame with nothing to say it had come from the header. It is always
     * laid out now and hidden by `visibility`, which does animate — and which, unlike
     * `opacity` alone, also takes the links out of the tab order and off the screen
     * reader while the menu is shut, so none of that had to be arranged by hand.
     *
     * The delay on `visibility` is what lets it stay visible for the length of the
     * closing slide instead of vanishing at the start of it.
     */
    .mobile-drawer {
        position: absolute;
        top: 70px;
        left: 0;
        right: 0;
        background: var(--bg-panel-color);
        border-bottom: 1px solid var(--border-color);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
        padding: 20px var(--gutter) 26px;
        z-index: 60;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px);
        transition:
            opacity 0.24s ease,
            transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
            visibility 0s linear 0.32s;
    }

    /*
     * Opaque, not 98% of it.
     *
     * Two per cent of the hero's heading came through the panel as a grey ghost behind
     * the menu — the kind of thing that reads as a rendering fault rather than as a
     * design. The translucency was there to let the page show through; that job belongs
     * to the scrim now, which dims what is *around* the drawer, and a panel you can see
     * the page through is a panel with nothing behind it. The blur went with it: it had
     * nothing left to blur.
     */
    :root[data-theme='light'] .mobile-drawer {
        background: #ffffff;
        border-bottom: 1px solid var(--border-color);
        box-shadow: 0 16px 40px rgba(11, 28, 21, 0.12);
    }

    .mobile-drawer.is-open {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        transition:
            opacity 0.2s ease,
            transform 0.36s cubic-bezier(0.22, 1, 0.36, 1),
            visibility 0s;
    }

    .mobile-drawer-inner {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-width: var(--measure);
        margin: 0 auto;
    }

    /*
     * The rows arrive in the order they are read, a frame or two apart.
     *
     * Everything landing at once is a panel appearing; landing in sequence is a list
     * being dealt, and it is the difference between a menu that opens and a menu that
     * is simply there. Sixth and last is the pair of buttons, which is where the eye
     * should end up.
     *
     * Delays only on the way in. On the way out they would hold the last row on screen
     * after the drawer had gone, and closing a menu is not a moment anyone wants drawn
     * out — so the closed state resets them to zero.
     */
    .mobile-drawer-inner > * {
        opacity: 0;
        transform: translateY(-6px);
        transition:
            opacity 0.001s,
            transform 0.001s;
    }

    .mobile-drawer.is-open .mobile-drawer-inner > * {
        opacity: 1;
        transform: translateY(0);
        transition:
            opacity 0.26s ease,
            transform 0.34s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .mobile-drawer.is-open .mobile-drawer-inner > :nth-child(1) {
        transition-delay: 0.04s;
    }

    .mobile-drawer.is-open .mobile-drawer-inner > :nth-child(2) {
        transition-delay: 0.08s;
    }

    .mobile-drawer.is-open .mobile-drawer-inner > :nth-child(3) {
        transition-delay: 0.12s;
    }

    .mobile-drawer.is-open .mobile-drawer-inner > :nth-child(4) {
        transition-delay: 0.16s;
    }

    .mobile-drawer.is-open .mobile-drawer-inner > :nth-child(5) {
        transition-delay: 0.2s;
    }

    .mobile-drawer.is-open .mobile-drawer-inner > :nth-child(6) {
        transition-delay: 0.24s;
    }

    .mobile-link {
        padding: 12px 14px;
        border-radius: var(--radius-sm);
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-color);
        transition:
            background 0.15s ease,
            color 0.15s ease,
            transform 0.12s ease;
    }

    .mobile-link:hover,
    .mobile-link:focus-visible {
        background: var(--bg-card-hover);
        color: var(--action-color);
    }

    /* A press has to answer on a screen with no pointer to hover with. */
    .mobile-link:active {
        transform: scale(0.985);
        background: var(--bg-card-hover);
    }

    :root[data-theme='light'] .mobile-link:hover {
        background: var(--bg-card-hover);
        color: var(--header-color);
    }

    .mobile-drawer-cta {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 8px;
        padding-top: 14px;
        border-top: 1px solid var(--border-subtle);
    }

    .mobile-contribute-link {
        min-height: 46px;
        font-size: 0.95rem;
    }

    .w-full {
        width: 100%;
    }

    /*
     * THE BAR IS SIX THINGS WIDE, AND UNDER ABOUT 1280px IT STOPS BEING SIX THINGS WIDE.
     *
     * Measured: the full bar needs 1280px to seat the install button inside the window.
     * Below that it used to simply overflow — and it did so before this contribute link
     * existed too, from roughly 1150px down to the 920px breakpoint, with "Add to
     * Chrome" pushed off the right-hand edge and no way to reach it. Nothing said so,
     * because an overflowing flex row neither wraps nor scrolls; it just leaves.
     *
     * So there are two steps now instead of one. First the row is tightened: the contribute
     * button drops to its heart, which is what an icon is for, and the links give back
     * the padding they can spare. Then, when even that does not fit, the whole thing
     * folds into the drawer — at 1120px rather than 920, because 920 was a promise the
     * bar could not keep.
     */
    @media (max-width: 1360px) {
        .nav-item {
            padding: 8px 10px;
        }

        .nav-links {
            gap: 4px;
        }

        .nav-actions {
            gap: 8px;
        }
    }

    /*
     * Everything above is decoration on top of a menu that opens either way. Somebody
     * who asked their system for less motion gets the same drawer, in place, at once —
     * `visibility` keeps its zero-second step so the links stay out of the tab order
     * while it is shut.
     */
    @media (prefers-reduced-motion: reduce) {
        /* The open states have to be named too. `.mobile-drawer.is-open` declares its own
           transition and outweighs a bare `.mobile-drawer` even from inside this block —
           measured: the drawer was still fading through 0.15 opacity forty milliseconds
           after the press, which is exactly the animation this is meant to remove. */
        .burger-bar,
        .mobile-scrim,
        .mobile-scrim.is-open,
        .mobile-drawer,
        .mobile-drawer.is-open,
        .mobile-drawer-inner > *,
        .mobile-drawer.is-open .mobile-drawer-inner > * {
            transition: none;
        }

        .mobile-drawer {
            transform: none;
        }

        .mobile-drawer-inner > * {
            transform: none;
        }

        .mobile-drawer.is-open .mobile-drawer-inner > * {
            transition-delay: 0s;
        }
    }

    /*
     * A PHONE IS NARROWER THAN THE BRAND PLUS THE CONTROLS.
     *
     * Measured on the live site: at 360px the header was 69px wider than the window, so
     * the whole page scrolled sideways — the oldest and least excusable mobile bug there
     * is, and it had nothing to do with the menu except that the menu button was the
     * thing being pushed off the edge.
     *
     * The controls are all fixed-size targets and none of them may shrink. The brand is
     * the one part that can give: the version tag goes, the name comes down a step and
     * is allowed to truncate rather than push. `min-width: 0` is what makes that
     * possible at all — a flex item refuses to shrink below its content without it, and
     * an ellipsis that can never trigger is not an ellipsis.
     */
    @media (max-width: 520px) {
        .header-inner {
            gap: 10px;
        }

        .nav-actions {
            gap: 8px;
        }

        .brand-link {
            flex-shrink: 1;
            min-width: 0;
        }

        .brand-text-block {
            min-width: 0;
        }

        .brand-name {
            font-size: 0.95rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .version-tag {
            display: none;
        }
    }

    @media (max-width: 1230px) {
        .nav-links {
            display: none;
        }

        .nav-install-btn,
        .nav-contribute-btn {
            display: none;
        }

        .mobile-toggle-btn {
            display: flex;
        }
    }
</style>
