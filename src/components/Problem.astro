---
/**
 * The pain, before the pitch.
 *
 * A reader who has not agreed there is a problem will not read a feature list. These are
 * symptoms in the first person, deliberately mundane — the point is recognition, not
 * persuasion.
 */
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import { symptoms } from '@/data/story';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="problem wrap" data-reveal>
    <div class="opener">
        <span class="numeral" aria-hidden="true">01</span>
        <p class="kicker">{t('problem.kicker')}</p>
        <h2>{t('problem.title')}</h2>
    </div>
    <ul class="symptoms">
        {symptoms.map((key) => <li>{t(key)}</li>)}
    </ul>
    <p class="turn">{t('problem.turn')}</p>
</section>

<style>
    .problem {
        padding-block: clamp(64px, 9vw, 116px);
        display: flex;
        flex-direction: column;
        gap: clamp(14px, 1.8vw, 22px);
    }

    .symptoms {
        list-style: none;
        margin: clamp(10px, 1.6vw, 18px) 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: clamp(14px, 2vw, 24px);
    }

    .symptoms li {
        font-size: clamp(16px, 1.3vw, 18.5px);
        line-height: 1.5;
        color: var(--ink-soft);
        padding-inline-start: 18px;
        /* A hairline instead of a bullet: the list reads as evidence, not as a menu. */
        border-inline-start: 2px solid var(--c-brass);
    }

    .turn {
        margin-block-start: clamp(12px, 2vw, 22px);
        font-size: clamp(18px, 1.6vw, 23px);
        font-weight: 560;
        letter-spacing: -0.014em;
        color: var(--ink);
        max-width: 46ch;
    }
</style>
