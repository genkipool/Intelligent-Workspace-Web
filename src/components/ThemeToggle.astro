---
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import Icon from '@/components/Icon.astro';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<button id="theme-toggle" type="button" class="theme-toggle-btn" aria-label={t('nav.theme')}>
    <Icon name="sun" size={16} class="sun" />
    <Icon name="moon" size={16} class="moon" />
</button>

<script>
    const KEY = 'iw-theme';
    const root = document.documentElement;

    function currentlyDark(): boolean {
        const stamped = root.dataset.theme;
        if (stamped === 'dark') return true;
        if (stamped === 'light') return false;
        return window.matchMedia('(prefers-color-scheme: dark)').matches;
    }

    function initThemeToggle() {
        const button = document.getElementById('theme-toggle');
        if (!button) return;

        const paint = () => {
            button.setAttribute('aria-pressed', String(currentlyDark()));
        };

        button.onclick = () => {
            const next = currentlyDark() ? 'light' : 'dark';
            root.dataset.theme = next;
            try {
                localStorage.setItem(KEY, next);
                localStorage.setItem('theme-mirror', next === 'dark' ? 'viridian' : 'light');
            } catch {}
            paint();
        };

        paint();
    }

    if (window.matchMedia) {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
            try {
                if (!localStorage.getItem(KEY) && !localStorage.getItem('theme-mirror')) {
                    root.dataset.theme = e.matches ? 'dark' : 'light';
                    initThemeToggle();
                }
            } catch {}
        });
    }

    initThemeToggle();
    document.addEventListener('astro:page-load', initThemeToggle);
</script>

<style>
    .theme-toggle-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        padding: 0;
        border-radius: var(--radius-full);
        border: 1px solid var(--border-color);
        background: var(--bg-panel-color);
        color: var(--text-soft);
        cursor: pointer;
        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    /* Colour and a glow on hover, and nothing that moves: the button sits in a row with
       the language pills and the install button, and lifting only this one made the row
       twitch under the cursor. */
    .theme-toggle-btn:hover {
        color: var(--accent-glow);
        border-color: var(--action-color);
        box-shadow: 0 4px 12px rgba(22, 160, 133, 0.15);
    }

    /* `:global` because the glyph is rendered by `Icon.astro`, so it carries that
       component's scope and not this one's. Astro scopes every part of a selector, and
       an unscoped element here would otherwise never be matched. */
    .theme-toggle-btn :global(svg) {
        fill: none;
        stroke: currentColor;
        stroke-width: 1.75;
    }

    .theme-toggle-btn :global(.moon) {
        fill: currentColor;
        stroke: none;
    }

    /* Pressed means the page is dark, so the button offers the sun. */
    .theme-toggle-btn[aria-pressed='true'] :global(.moon),
    .theme-toggle-btn[aria-pressed='false'] :global(.sun) {
        display: none;
    }
</style>
