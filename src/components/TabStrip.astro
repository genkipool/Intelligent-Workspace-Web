---
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * The four groups, laid out along a 1200-unit strip. Widths are the data: they are what
 * makes the picture read as "a lot of tabs folded into a few named things".
 */
const groups = [
    { tone: 'viridian', x: 0, w: 268, label: 'Work · 9' },
    { tone: 'teal', x: 284, w: 252, label: 'Docs · 6' },
    { tone: 'pine', x: 552, w: 300, label: 'Research · 12' },
    { tone: 'brass', x: 868, w: 332, label: 'Read later · 13' },
] as const;

/** Ten loose tabs, evenly spaced. Generated rather than written out ten times. */
const loose = Array.from({ length: 10 }, (_, i) => ({ x: i * 122, w: i === 9 ? 102 : 112 }));
---

<figure class="strip" aria-labelledby="strip-caption">
    <svg viewBox="0 0 1200 130" preserveAspectRatio="xMidYMid meet" role="img" aria-label={t('strip.alt')}>
        <g class="loose">
            {loose.map((tab) => <rect x={tab.x} y="0" width={tab.w} height="30" rx="7" />)}
        </g>

        <path class="fall" d="M600 46 v26 m-10-10 10 10 10-10"></path>

        <g class="groups">
            {
                groups.map((group) => (
                    <g style={`--c: var(--c-${group.tone})`}>
                        <rect x={group.x} y="90" width={group.w} height="34" rx="9" />
                        <circle cx={group.x + 22} cy="107" r="5.5" />
                        <text x={group.x + 40} y="112">
                            {group.label}
                        </text>
                    </g>
                ))
            }
        </g>
    </svg>

    <p class="exchange">
        <span class="said">{t('strip.said')}</span>
        <span class="did">{t('strip.did')}</span>
    </p>
    <figcaption id="strip-caption">{t('strip.caption')}</figcaption>
</figure>

<style>
    .strip {
        margin: 0;
        padding: clamp(48px, 7vw, 88px) var(--gutter) 0;
        max-width: calc(var(--measure) + 120px);
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        text-align: center;
    }

    .strip svg {
        display: block;
        width: 100%;
        height: auto;
        /* Fades out at both ends rather than stopping at a hard edge, so the strip reads
           as a fragment of something longer — which is what a tab strip is. */
        mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    }

    .loose rect {
        fill: var(--surface-2, color-mix(in srgb, var(--ink) 6%, transparent));
    }

    .fall {
        fill: none;
        stroke: var(--muted);
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.55;
    }

    .groups rect {
        fill: color-mix(in srgb, var(--c) 14%, transparent);
        stroke: color-mix(in srgb, var(--c) 35%, transparent);
    }

    .groups circle {
        fill: var(--c);
    }

    .groups text {
        fill: var(--ink);
        font-family: var(--display);
        font-size: 14px;
        font-weight: 500;
    }

    /* The exchange is HTML, not SVG <text>: inside a 1200-unit viewBox scaled down to a
       390px phone, 14px type renders at about 4px. As HTML it reflows and stays legible. */
    .exchange {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .said {
        color: var(--muted);
        font-size: 0.95rem;
        font-weight: 350;
    }

    .did {
        color: var(--accent);
        font-family: var(--mono);
        font-size: 0.78rem;
        letter-spacing: 0.01em;
    }

    figcaption {
        font-size: 0.86rem;
        color: var(--muted);
        max-width: 60ch;
        opacity: 0.85;
    }

    @media (max-width: 640px) {
        .groups text {
            display: none;
        }
    }
</style>
