---
/**
 * One tab panel: the copy on one side, the shot of the thing it describes on the other.
 *
 * The shot goes in the default slot, because it is the only part that differs beyond a
 * key prefix. Everything else — the panel's ids, its ARIA wiring, the title, the lead and
 * the four checks — comes from the `Pillar` entry, so the tab strip in `Features.astro`
 * and the panel it controls are generated from the same row and cannot disagree.
 */
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import type { Pillar } from '@/data/pillars';

interface Props {
    lang: Lang;
    pillar: Pillar;
    /** The first panel is the one open on arrival. */
    active?: boolean;
}

/*
 * The three closed panels carry `hidden` in the markup, not only `display: none` from
 * the stylesheet. Before the tab script runs — and if it never does — `hidden` is what
 * keeps their headings and their four checks out of the accessibility tree, so a screen
 * reader is not read all four pillars at once as though they were one long section.
 */

const { lang, pillar, active = false } = Astro.props;
const t = useTranslations(lang);
---

<div
    id={`tab-${pillar.id}`}
    class:list={['tab-panel', { active }]}
    role="tabpanel"
    aria-labelledby={`tab-btn-${pillar.id}`}
    tabindex="0"
    hidden={!active}
>
    <div class="panel-grid">
        <div class="panel-info">
            <h3 class="panel-title">{t(pillar.titleKey)}</h3>
            <p class="panel-lead">{t(pillar.leadKey)}</p>
            <ul class="feature-checklist">
                {
                    pillar.checkKeys.map((key) => (
                        <li>
                            <span class="check-icon">✓</span>
                            <span>{t(key)}</span>
                        </li>
                    ))
                }
            </ul>
        </div>

        <slot />
    </div>
</div>

<style>
    /*
     * These belong here rather than in `Features.astro` because Astro scopes a style to
     * the component that rendered the element. When the panel's markup moved into this
     * file its styles stayed behind, and every one of them silently stopped matching:
     * the two-column grid, the card, the typography and the fade all went with it.
     */
    /* Tab Panels */
    .tab-panel {
        display: none;
    }

    .tab-panel.active {
        display: block;
        animation: tabFadeIn 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .tab-panel[hidden] {
        display: none !important;
    }

    .tab-panel:focus-visible {
        outline: 2px solid var(--action-color);
        outline-offset: 4px;
        border-radius: var(--radius-lg);
    }

    @keyframes tabFadeIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .panel-grid {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: clamp(32px, 5vw, 64px);
        align-items: center;
        background: var(--bg-panel-color);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: clamp(32px, 5vw, 56px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    :root[data-theme='light'] .panel-grid {
        background: #ffffff;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 20px rgba(11, 28, 21, 0.05);
    }

    .panel-info {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .panel-title {
        font-size: clamp(1.8rem, 2.6vw, 2.3rem);
        color: var(--text-color);
    }

    .panel-lead {
        font-size: 1.05rem;
        color: var(--text-soft);
        line-height: 1.65;
    }

    .feature-checklist {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .feature-checklist li {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        font-size: 0.95rem;
        color: var(--text-soft);
        line-height: 1.5;
    }

    .check-icon {
        color: var(--action-color);
        font-weight: 800;
        font-size: 1rem;
        line-height: 1.2;
    }

    :root[data-theme='light'] .check-icon {
        color: var(--header-color);
    }

    @media (prefers-reduced-motion: reduce) {
        .tab-panel.active {
            animation: none;
        }
    }

    @media (max-width: 900px) {
        .panel-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
