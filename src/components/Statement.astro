---
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="privacy" class="statement wrap">
    <p class="kicker">{t('privacy.kicker')}</p>
    <p class="big">{t('privacy.answer')}</p>
    <p class="statement-body">{t('privacy.body')}</p>
</section>

<style>
    /* ── Statement ─────────────────────────────────────────────────── */

    .statement {
        padding-block: clamp(72px, 11vw, 150px);
        display: flex;
        flex-direction: column;
        gap: clamp(14px, 1.6vw, 20px);
    }

    .kicker {
        font-size: clamp(11px, 1vw, 12.5px);
        font-weight: 640;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .big {
        font-size: clamp(48px, 11vw, 132px);
        font-weight: 700;
        letter-spacing: -0.045em;
        line-height: 0.95;
        color: var(--tg-green);
    }

    .statement-body {
        font-size: clamp(17px, 1.5vw, 21px);
        line-height: 1.55;
        color: var(--ink-soft);
        max-width: 60ch;
        margin-block-start: clamp(8px, 1vw, 14px);
    }
</style>
