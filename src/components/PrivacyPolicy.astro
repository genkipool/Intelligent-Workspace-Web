---
/**
 * The privacy policy, as a page rather than a wall.
 *
 * The header and footer are `DocTopbar` and `DocFooter` rather than the landing page's:
 * every link in `Nav.astro` and `SiteFooter.astro` is an anchor into a section of that
 * page, and an anchor to a section that is not on this one is a dead link. What is here
 * goes somewhere real, and the link back into the landing is an absolute path rather
 * than a fragment.
 *
 * The two tables are the point of the document. A policy is usually a paragraph saying
 * "we store some things locally"; these say which things, in which storage area, and
 * whether that area leaves the machine — which is the only form of the claim a reader can
 * actually check against `chrome://extensions` or against the source. They come from
 * `@/data/privacy`, so the page cannot say something the data does not.
 *
 * The contents rail is `position: sticky` on wide screens and a plain list above the text
 * on narrow ones. It is a `<nav>` with a label so it is skippable, because on a document
 * this long a screen reader hearing thirteen links before the first sentence is the
 * difference between a table of contents and an obstacle.
 */
import { useTranslations, localisePath } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import { site } from '@/data/site';
import { sections, basicRows, storageRows, connectionRows, effectiveDate } from '@/data/privacy';
import Icon from '@/components/Icon.astro';
import DocTopbar from '@/components/DocTopbar.astro';
import DocFooter from '@/components/DocFooter.astro';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const homeUrl = localisePath(lang, '/');
/* The permission table lives in the landing page's trust section. An absolute path plus
   the fragment, so it works from here and keeps working if this page is ever framed. */
const permissionsUrl = `${homeUrl}#privacidad`;

const effectiveLabel = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
}).format(new Date(`${effectiveDate}T00:00:00Z`));

const summaryCards = [
    { icon: 'lock', title: t('privacy.sum1.title'), desc: t('privacy.sum1.desc') },
    { icon: 'key', title: t('privacy.sum2.title'), desc: t('privacy.sum2.desc') },
    { icon: 'shield', title: t('privacy.sum3.title'), desc: t('privacy.sum3.desc') },
] as const;
---

<DocTopbar lang={lang} />

<main class="policy-main" id="main">
    <div class="wrap policy-head">
        <span class="section-eyebrow">{t('privacy.eyebrow')}</span>
        <h1 class="policy-title">{t('privacy.title')}</h1>
        <p class="policy-date">
            {t('privacy.effective')}{' '}<time datetime={effectiveDate}>{effectiveLabel}</time>
        </p>
        <p class="policy-lede">{t('privacy.lede')}</p>

        <div class="policy-summary" data-reveal>
            {
                summaryCards.map((card) => (
                    <div class="glass-card policy-sum-card">
                        <div class="policy-sum-icon">
                            <Icon name={card.icon} size={20} />
                        </div>
                        <h2 class="policy-sum-title">{card.title}</h2>
                        <p class="policy-sum-desc">{card.desc}</p>
                    </div>
                ))
            }
        </div>

        <!-- The formal first layer. The three cards above say it in plain words; this
             says it in the six fields the AEPD publishes, which is the form a reviewer
             is looking for. -->
        <section class="policy-basic" aria-labelledby="policy-basic-heading">
            <h2 class="policy-basic-heading" id="policy-basic-heading">{t('privacy.basic.heading')}</h2>
            <dl class="policy-basic-list">
                {
                    basicRows.map((row) => (
                        <div class="policy-basic-row">
                            <dt>{t(row.labelKey)}</dt>
                            <dd>{t(row.valueKey)}</dd>
                        </div>
                    ))
                }
            </dl>
        </section>
    </div>

    <div class="wrap policy-body">
        <nav class="policy-toc" aria-label={t('privacy.toc')}>
            <p class="policy-toc-title">{t('privacy.toc')}</p>
            <ol class="policy-toc-list">
                {
                    sections.map((section) => (
                        <li>
                            <a href={`#${section.id}`} data-toc={section.id}>
                                {t(section.titleKey)}
                            </a>
                        </li>
                    ))
                }
            </ol>
        </nav>

        <article class="policy-article">
            <section id="scope">
                <h2>{t('privacy.scope.title')}</h2>
                <p>{t('privacy.scope.p1')}</p>
                <p>{t('privacy.scope.p2')}</p>
            </section>

            <section id="basis">
                <h2>{t('privacy.basis.title')}</h2>
                <p>{t('privacy.basis.p1')}</p>
                <ul class="policy-list">
                    <li>{t('privacy.basis.li1')}</li>
                    <li>{t('privacy.basis.li2')}</li>
                    <li>{t('privacy.basis.li3')}</li>
                    <li>{t('privacy.basis.li4')}</li>
                </ul>
                <p>{t('privacy.basis.p2')}</p>
            </section>

            <section id="store">
                <h2>{t('privacy.store.title')}</h2>
                <p>{t('privacy.store.p1')}</p>

                <div class="policy-table-scroll">
                    <table class="policy-table">
                        <thead>
                            <tr>
                                <th scope="col">{t('privacy.store.colWhat')}</th>
                                <th scope="col">{t('privacy.store.colWhere')}</th>
                                <th scope="col">{t('privacy.store.colLeaves')}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                storageRows.map((row) => (
                                    <tr>
                                        <td>{t(row.whatKey)}</td>
                                        <td>
                                            <code class="policy-code">{row.where}</code>
                                        </td>
                                        <td>{t(row.leavesKey)}</td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>

                <p class="policy-note">{t('privacy.store.note')}</p>
            </section>

            <section id="sync">
                <h2>{t('privacy.sync.title')}</h2>
                <p>{t('privacy.sync.p1')}</p>
                <p>{t('privacy.sync.p2')}</p>
            </section>

            <section id="network">
                <h2>{t('privacy.net.title')}</h2>
                <p>{t('privacy.net.p1')}</p>

                <div class="policy-table-scroll">
                    <table class="policy-table">
                        <thead>
                            <tr>
                                <th scope="col">{t('privacy.net.colWhere')}</th>
                                <th scope="col">{t('privacy.net.colWhat')}</th>
                                <th scope="col">{t('privacy.net.colWhen')}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                connectionRows.map((row) => (
                                    <tr>
                                        <td>
                                            {row.host ? (
                                                <code class="policy-code">{row.host}</code>
                                            ) : (
                                                t(row.hostKey!)
                                            )}
                                        </td>
                                        <td>{t(row.sendsKey)}</td>
                                        <td>{t(row.whenKey)}</td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>

                <p>{t('privacy.net.p2')}</p>
            </section>

            <section id="transfers">
                <h2>{t('privacy.transfers.title')}</h2>
                <p>{t('privacy.transfers.p1')}</p>
                <p>{t('privacy.transfers.p2')}</p>
            </section>

            <section id="retention">
                <h2>{t('privacy.retention.title')}</h2>
                <p>{t('privacy.retention.p1')}</p>
                <ul class="policy-list">
                    <li>{t('privacy.retention.li1')}</li>
                    <li>{t('privacy.retention.li2')}</li>
                    <li>{t('privacy.retention.li3')}</li>
                    <li>{t('privacy.retention.li4')}</li>
                </ul>
                <p>{t('privacy.retention.p2')}</p>
            </section>

            <section id="ai">
                <h2>{t('privacy.ai.title')}</h2>
                <p>{t('privacy.ai.p1')}</p>
                <p>{t('privacy.ai.p2')}</p>
                <p>{t('privacy.ai.p3')}</p>
            </section>

            <section id="permissions">
                <h2>{t('privacy.perm.title')}</h2>
                <p>{t('privacy.perm.p1')}</p>
                <p>{t('privacy.perm.p2')}</p>
                <p>{t('privacy.perm.p3')}</p>
                <p>{t('privacy.perm.p4')}</p>
                <p class="policy-actions">
                    <a href={permissionsUrl} class="policy-link">{t('privacy.perm.cta')}</a>
                </p>
            </section>

            <section id="website">
                <h2>{t('privacy.site.title')}</h2>
                <p>{t('privacy.site.p1')}</p>
                <p>{t('privacy.site.p2')}</p>
                <p>{t('privacy.site.p3')}</p>
            </section>

            <section id="cookies">
                <h2>{t('privacy.cookies.title')}</h2>
                <p>{t('privacy.cookies.p1')}</p>
                <p>{t('privacy.cookies.p2')}</p>
            </section>

            <section id="payments">
                <h2>{t('privacy.pay.title')}</h2>
                <p>{t('privacy.pay.p1')}</p>
                <p>{t('privacy.pay.p2')}</p>
                <p>{t('privacy.pay.p3')}</p>
            </section>

            <section id="limited-use">
                <h2>{t('privacy.limited.title')}</h2>
                <p>{t('privacy.limited.p1')}</p>
            </section>

            <section id="rights">
                <h2>{t('privacy.rights.title')}</h2>
                <p>{t('privacy.rights.p1')}</p>
                <ul class="policy-list">
                    <li>{t('privacy.rights.li1')}</li>
                    <li>{t('privacy.rights.li2')}</li>
                    <li>{t('privacy.rights.li3')}</li>
                    <li>{t('privacy.rights.li4')}</li>
                    <li>{t('privacy.rights.li5')}</li>
                    <li>{t('privacy.rights.li6')}</li>
                </ul>
                <p>{t('privacy.rights.p2')}</p>
                <p>{t('privacy.rights.p3')}</p>
            </section>

            <section id="legal">
                <h2>{t('privacy.legal.title')}</h2>
                <p>{t('privacy.legal.p1')}</p>
                <p>{t('privacy.legal.p2')}</p>
                <p>{t('privacy.legal.p3')}</p>
            </section>

            <section id="changes">
                <h2>{t('privacy.changes.title')}</h2>
                <p>{t('privacy.changes.p1')}</p>
            </section>

            <section id="contact">
                <h2>{t('privacy.contact.title')}</h2>
                <p>{t('privacy.contact.p1')}</p>
                <p class="policy-contact-address">
                    <a href={`mailto:${site.privacyEmail}`}>{site.privacyEmail}</a>
                </p>
                <div class="policy-actions">
                    <a href={`mailto:${site.privacyEmail}`} class="btn-primary policy-btn">
                        {t('privacy.contact.email')}
                    </a>
                    <a
                        href={site.sourceUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-secondary policy-btn"
                    >
                        <Icon name="github" size={16} />
                        <span>{t('privacy.contact.source')}</span>
                    </a>
                </div>
            </section>
        </article>
    </div>
</main>

<script>
    /**
     * The contents rail follows the reader.
     *
     * An `IntersectionObserver` on its own answers the wrong question here: it reports
     * which sections are *visible*, and on a screen showing three of them at once it has
     * no opinion about which one is being read. So the observer only maintains the set of
     * visible sections, and the topmost of that set is the one marked. That is what a
     * reader means by "where I am".
     *
     * The band is deliberately narrow. `rootMargin` crops the viewport to a strip near the
     * top, so a section counts as current once its heading reaches roughly the first third
     * of the screen, instead of the moment its last line scrolls into view at the bottom.
     *
     * The last section is short, so at the very end of the document nothing new can enter
     * the band; the scroll listener handles that case by pinning the final entry once the
     * page is scrolled to the bottom. Without it, "Contact" is the one link the rail can
     * never highlight.
     */
    function initPolicyToc(): void {
        const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
        if (links.length === 0) return;

        const sections = links
            .map((link) => document.getElementById(link.dataset.toc!))
            .filter((section): section is HTMLElement => section !== null);
        if (sections.length === 0) return;

        const visible = new Set<string>();
        let pinned: string | null = null;

        const paint = () => {
            const atBottom = window.innerHeight + window.scrollY >= document.body.scrollHeight - 4;
            const current = atBottom
                ? sections[sections.length - 1]!.id
                : (sections.find((section) => visible.has(section.id))?.id ?? pinned);

            if (current === pinned && current !== null) return;
            pinned = current;

            for (const link of links) {
                const isCurrent = link.dataset.toc === current;
                link.classList.toggle('active', isCurrent);
                if (isCurrent) link.setAttribute('aria-current', 'true');
                else link.removeAttribute('aria-current');
            }
        };

        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) visible.add(entry.target.id);
                    else visible.delete(entry.target.id);
                }
                paint();
            },
            { rootMargin: '0px 0px -66% 0px', threshold: 0 },
        );

        for (const section of sections) observer.observe(section);
        window.addEventListener('scroll', paint, { passive: true });
        paint();
    }

    initPolicyToc();
    document.addEventListener('astro:page-load', initPolicyToc);
</script>

<DocFooter lang={lang} current="privacy" />

<style>
    /* ── The opening ── */
    .policy-main {
        position: relative;
        z-index: 1;
        flex: 1;
    }

    /*
     * The document is a column, and the column is centred.
     *
     * `.wrap` is 1240px wide because the landing page needs it. A legal text does not:
     * capping the prose at a readable measure inside that width left the article hugging
     * the left edge with 300px of nothing beside it, which reads as a layout accident
     * rather than as a margin. So this page narrows the container and centres it, and
     * everything inside shares one left edge and one right edge: the rail, the headings,
     * the paragraphs and both tables.
     */
    .policy-head,
    .policy-body {
        /*
         * `.wrap` is `border-box` and carries the gutter as padding, so a flat
         * `max-width: 1000px` here spends up to 128px of it on the gutter and hands the
         * article 592px instead of the 720 it was sized for, which put the table columns
         * back to wrapping. Adding the gutter back keeps the *content* at 980 whatever
         * the viewport does to the gutter.
         */
        max-width: calc(980px + var(--gutter) * 2);
        margin-inline: auto;
    }

    .policy-head {
        padding-block: clamp(40px, 6vw, 76px) clamp(28px, 4vw, 44px);
        text-align: center;
    }

    .policy-title {
        margin-top: 10px;
        font-size: clamp(2.1rem, 4.6vw, 3.2rem);
        font-weight: 800;
        letter-spacing: -0.035em;
        line-height: 1.1;
        color: var(--text-color);
    }

    .policy-date {
        margin-top: 12px;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: var(--text-dim);
    }

    .policy-lede {
        margin-top: 20px;
        max-width: 68ch;
        /* Centred as a block, ranged left as text. Centring the lines of a paragraph this
           long costs exactly what article 12 of the GDPR asks for, which is that the
           reader can follow it without hunting for where each line starts. */
        text-align: left;
        margin-inline: auto;
        font-size: clamp(1.02rem, 1.3vw, 1.15rem);
        line-height: 1.75;
        color: var(--text-soft);
    }

    .policy-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-top: 34px;
    }

    .policy-sum-card {
        padding: 24px;
    }

    .policy-sum-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        margin-bottom: 12px;
        border-radius: 10px;
        background: rgba(22, 160, 133, 0.15);
        border: 1px solid rgba(26, 188, 156, 0.3);
        color: var(--action-color);
    }

    :root[data-theme='light'] .policy-sum-icon {
        background: #edf6f2;
        border: 1px solid #b8dacb;
        color: var(--header-color);
    }

    .policy-sum-title {
        font-size: 1.02rem;
        font-weight: 700;
        margin-bottom: 6px;
        color: var(--text-color);
    }

    .policy-sum-desc {
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--text-soft);
    }

    /* ── The first layer ── */
    .policy-basic {
        margin-top: 34px;
        padding: clamp(20px, 3vw, 30px);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        background: var(--bg-surface);
        text-align: left;
    }

    :root[data-theme='light'] .policy-basic {
        background: var(--bg-surface);
    }

    .policy-basic-heading {
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--text-dim);
        margin-bottom: 18px;
        text-align: center;
    }

    .policy-basic-list {
        display: flex;
        flex-direction: column;
    }

    .policy-basic-row {
        display: grid;
        grid-template-columns: 150px minmax(0, 1fr);
        gap: 16px;
        padding-block: 11px;
        border-top: 1px solid var(--border-subtle);
    }

    .policy-basic-row:first-child {
        border-top: none;
        padding-top: 0;
    }

    .policy-basic-row dt {
        font-size: 0.78rem;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--action-color);
        padding-top: 3px;
    }

    :root[data-theme='light'] .policy-basic-row dt {
        color: var(--header-color);
    }

    .policy-basic-row dd {
        font-size: 0.94rem;
        line-height: 1.65;
        color: var(--text-soft);
    }

    /* ── Contents rail and article ── */
    .policy-body {
        display: grid;
        grid-template-columns: 220px minmax(0, 1fr);
        gap: clamp(28px, 3vw, 44px);
        padding-bottom: clamp(56px, 8vw, 110px);
        align-items: start;
    }

    .policy-toc {
        position: sticky;
        top: 28px;
        padding: 20px;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        background: var(--bg-panel-color);
    }

    :root[data-theme='light'] .policy-toc {
        background: #ffffff;
    }

    .policy-toc-title {
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--text-dim);
        margin-bottom: 12px;
    }

    .policy-toc-list {
        list-style: none;
        counter-reset: toc;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .policy-toc-list a {
        display: block;
        padding: 5px 0;
        font-size: 0.85rem;
        line-height: 1.4;
        color: var(--text-muted);
        text-decoration: none;
        transition: color 0.18s ease;
    }

    .policy-toc-list a::before {
        content: counter(toc) '. ';
        color: var(--text-dim);
        font-variant-numeric: tabular-nums;
    }

    .policy-toc-list a:hover {
        color: var(--action-color);
    }

    /*
     * Where the reader is. `active` is put on by the script above, so it never appears in
     * the built HTML; it is in `ADDED_AT_RUNTIME` in `scoped-styles.test.ts` for that
     * reason. Colour alone would not do it, so the entry also gains weight and a rule down
     * its left side, which survives a colourblind reader and a monochrome print.
     */
    .policy-toc-list a.active {
        color: var(--action-color);
        font-weight: 700;
    }

    .policy-toc-list a.active::before {
        color: var(--action-color);
    }

    .policy-toc-list li {
        counter-increment: toc;
        border-left: 2px solid transparent;
        padding-left: 10px;
        margin-left: -12px;
        transition: border-color 0.18s ease;
    }

    .policy-toc-list li:has(a.active) {
        border-left-color: var(--action-color);
    }

    /*
     * No cap on the prose any more. The column itself is the measure: 1000px less the rail
     * and the gap leaves the article around 700px, which at this size is a little over
     * eighty characters a line. That is the top of the comfortable range rather than the
     * middle of it, and it is what the narrower container buys, since capping the
     * paragraphs any tighter is exactly what put the empty band back beside them.
     */
    /*
     * A measure again, but a generous one. Unbounded, the paragraphs ran the full 716px of
     * the column, which is past ninety characters a line; capped at the old 74ch they left
     * a 150px band of nothing beside them, which is the smaller version of the problem the
     * narrower container was meant to solve. 80ch sits between the two, and the tables
     * still get the whole column because the cap is on the prose, not on the article.
     */
    .policy-article {
        text-align: left;
    }

    .policy-article p,
    .policy-list {
        max-width: 80ch;
    }

    .policy-article section {
        /* The sticky header is only 28px away, so an anchored heading needs room above
           it or the fragment jump lands with the title touching the top of the window. */
        scroll-margin-top: 28px;
        padding-block: 26px;
        border-top: 1px solid var(--border-subtle);
    }

    .policy-article section:first-child {
        border-top: none;
        padding-top: 0;
    }

    .policy-article h2 {
        font-size: clamp(1.3rem, 2vw, 1.6rem);
        font-weight: 750;
        letter-spacing: -0.02em;
        color: var(--text-color);
        margin-bottom: 14px;
    }

    .policy-article p {
        font-size: 1rem;
        line-height: 1.78;
        color: var(--text-soft);
    }

    .policy-article p + p,
    /* `p + p` covers prose against prose and nothing else, so the paragraph that closes a
       section after a list or a table was sitting flush against it. */
    .policy-article .policy-list + p,
    .policy-article .policy-table-scroll + p {
        margin-top: 16px;
    }

    .policy-list {
        list-style: none;
        margin-top: 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .policy-list li {
        position: relative;
        padding-left: 22px;
        font-size: 0.98rem;
        line-height: 1.7;
        color: var(--text-soft);
    }

    .policy-list li::before {
        content: '';
        position: absolute;
        left: 4px;
        top: 0.72em;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--action-color);
    }

    /* Written under `.policy-article` so it outranks that block's own `p` rule rather
       than having to fight it with `!important`. */
    .policy-article .policy-note {
        margin-top: 16px;
        padding: 14px 18px;
