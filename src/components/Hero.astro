---
/**
 * The hero, sized to fit one screen.
 *
 * `100svh` and not `100vh`: on a phone the large viewport unit measures the window with
 * the browser's own toolbars hidden, so a `100vh` hero is taller than what is actually
 * on screen and the reader has to scroll to reach the button. The small unit is the
 * height that is really visible.
 *
 * Everything here is sized in `svh` fractions and `clamp`s that shrink together, so the
 * composition holds on a laptop with a short viewport as well as on a desktop. The
 * headline is kept to at most two lines by its measure — 18ch is narrower than the
 * shortest sensible headline in either language, so it cannot run to three.
 */
import { Image } from 'astro:assets';
import { useTranslations, localisePath } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import { site } from '@/data/site';
import logo from '@/assets/logo.png';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero aurora">
    <div class="hero-inner wrap">
        <!--
            The mark's four dots are the tab colours the whole palette is built from, and
            the group chips further down the page are painted in the same four. `Image`
            reads its intrinsic size from the file, so it cannot shift the headline while
            it loads.
        -->
        <Image src={logo} alt={site.name} class="mark" width={176} height={176} loading="eager" />

        <p class="eyebrow">
            <span class="dot" aria-hidden="true"></span>
            {t('hero.eyebrow.a')}
            <span class="sep" aria-hidden="true">·</span>
            {t('hero.eyebrow.b')}
        </p>

        <h1>{t('hero.title')}</h1>
        <p class="lede">{t('hero.lede')}</p>

        <div class="actions">
            <a class="cta" href={site.storeUrl} rel="noopener">{t('hero.install')}</a>
            <a class="link-cta" href={localisePath(lang, '/pay')}>
                {t('hero.support')}
                <span class="arrow" aria-hidden="true">→</span>
            </a>
        </div>
    </div>

    <!-- The cue that there is more below. A link rather than an icon on its own, so it
         works for the keyboard and says what it does. -->
    <a class="scroll-cue" href="#what">
        <span>{t('hero.scroll')}</span>
        <span class="chev" aria-hidden="true"></span>
    </a>
</section>

<style>
    .hero {
        /* The nav sits above this inside the same band, so the hero claims the rest of
           the screen rather than a whole one of its own. */
        min-height: calc(100svh - var(--nav-height, 76px));
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-block: clamp(20px, 4svh, 56px) clamp(48px, 8svh, 90px);
        position: relative;
    }

    .hero-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: clamp(12px, 1.8svh, 24px);
    }

    .mark {
        width: clamp(52px, 7svh, 88px);
        height: auto;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: clamp(0.68rem, 1.4svh, 0.76rem);
        font-weight: 560;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--band-soft);
    }

    .dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--accent);
    }

    .sep {
        opacity: 0.45;
    }

    h1 {
        /* 18ch is narrower than the shortest headline either language would sensibly
           carry, so this can only ever break to two lines — never three. */
        font-size: clamp(38px, min(7.4vw, 9.4svh), 84px);
        font-weight: 250;
        letter-spacing: -0.042em;
        line-height: 1.02;
        max-width: 18ch;
        color: var(--band-ink);
    }

    .lede {
        font-size: clamp(16px, min(1.5vw, 2.4svh), 20px);
        font-weight: 350;
        line-height: 1.5;
        color: var(--band-soft);
        max-width: 54ch;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: clamp(12px, 2.2vw, 26px);
        padding-block-start: clamp(4px, 1svh, 14px);
    }

    .link-cta {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font-size: 0.95rem;
        font-weight: 480;
        color: var(--band-ink);
        text-decoration: none;
    }

    .link-cta .arrow {
        transition: transform 0.18s ease;
    }

    .link-cta:hover .arrow {
        transform: translateX(5px);
    }

    /* ── Scroll cue ─────────────────────────────────────────────── */

    .scroll-cue {
        position: absolute;
        inset-inline: 0;
        inset-block-end: clamp(16px, 3svh, 34px);
        margin-inline: auto;
        width: fit-content;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        font-size: 0.72rem;
        font-weight: 560;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--band-soft);
        text-decoration: none;
        opacity: 0.75;
        transition: opacity 0.2s ease;
    }

    .scroll-cue:hover {
        opacity: 1;
    }

    .chev {
        width: 8px;
        height: 8px;
        border-right: 1.5px solid currentColor;
        border-bottom: 1.5px solid currentColor;
        transform: rotate(45deg);
        animation: nudge 2.4s ease-in-out infinite;
    }

    @keyframes nudge {
        0%,
        100% {
            transform: rotate(45deg) translate(0, 0);
        }
        50% {
            transform: rotate(45deg) translate(3px, 3px);
        }
    }

    /* A short viewport — a laptop in landscape — has no room for the cue, and the hero
       is already the whole screen. Hiding it is better than letting it collide. */
    @media (max-height: 620px) {
        .scroll-cue {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .chev {
            animation: none;
        }

        .link-cta .arrow,
        .link-cta:hover .arrow {
            transition: none;
            transform: none;
        }
    }
</style>
