---
/**
 * The hero.
 *
 * Centred, on a wash of viridian light, with the type carrying everything. There is no
 * panel, no frame and no card anywhere in it — the composition is the logo, a line of
 * very large light-weight type, one sentence, and two calls to action, with a great deal
 * of air between them.
 *
 * The wash is CSS, not an image: two soft radial fields offset from each other, so it
 * costs nothing to load, follows the theme, and cannot pixelate.
 */
import { Image } from 'astro:assets';
import { useTranslations, localisePath } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import { site } from '@/data/site';
import logo from '@/assets/logo.png';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero aurora">
    <div class="hero-inner wrap">
        <!--
            The mark earns its place: its four dots are the tab colours the whole palette
            is built from, and the group chips further down are painted in the same four.
            `Image` reads its intrinsic size from the file, so it cannot shift the
            headline while it loads.
        -->
        <Image src={logo} alt={site.name} class="mark" width={176} height={176} loading="eager" />

        <p class="eyebrow">
            <span class="dot" aria-hidden="true"></span>
            {t('hero.eyebrow.a')}
            <span class="sep" aria-hidden="true">·</span>
            {t('hero.eyebrow.b')}
        </p>

        <h1>{t('hero.title')}</h1>
        <p class="lede">{t('hero.lede')}</p>

        <div class="actions">
            <a class="cta" href={site.storeUrl} rel="noopener">{t('hero.install')}</a>
            <a class="link-cta" href={localisePath(lang, '/pay')}>
                {t('hero.support')}
                <span class="arrow" aria-hidden="true">→</span>
            </a>
        </div>
    </div>
</section>

<style>
    .hero {
        padding-block: clamp(56px, 9vw, 120px) clamp(40px, 6vw, 72px);
    }

    .hero-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: clamp(18px, 2.2vw, 28px);
    }

    .mark {
        width: clamp(72px, 8vw, 104px);
        height: auto;
        margin-block-end: clamp(2px, 1vw, 10px);
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 0.76rem;
        font-weight: 560;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--band-soft);
    }

    .dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--accent);
    }

    .sep {
        opacity: 0.45;
    }

    h1 {
        /* The one place the page is loud, and it is loud by size rather than by weight.
           15ch keeps it to three lines at desktop width in both languages. */
        font-size: clamp(42px, 7.6vw, 92px);
        font-weight: 250;
        letter-spacing: -0.042em;
        line-height: 1;
        max-width: 15ch;
        color: var(--band-ink);
    }

    .lede {
        font-size: clamp(17px, 1.5vw, 21px);
        font-weight: 350;
        line-height: 1.55;
        color: var(--band-soft);
        max-width: 52ch;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: clamp(14px, 2.2vw, 26px);
        padding-block-start: clamp(8px, 1.2vw, 16px);
    }

    .link-cta {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font-size: 0.95rem;
        font-weight: 480;
        color: var(--band-ink);
        text-decoration: none;
    }

    .link-cta .arrow {
        transition: transform 0.18s ease;
    }

    .link-cta:hover .arrow {
        transform: translateX(5px);
    }

    @media (prefers-reduced-motion: reduce) {
        .link-cta .arrow,
        .link-cta:hover .arrow {
            transition: none;
            transform: none;
        }
    }
</style>
