---
/**
 * The centred heading nine sections open with: an optional eyebrow, a title, and a line
 * under it. It was nine copies of the same four lines of markup, and the eyebrow had
 * already drifted — two sections set it at 0.82rem and one at 0.8rem, which is the sort
 * of difference nobody chooses and nobody notices until the two sit side by side.
 *
 * `Trust.astro` builds its subtitle from a count rather than a key, so the subtitle can
 * arrive either way.
 */
import { useTranslations } from '@/i18n/utils';
import type { Lang, TranslationKey } from '@/i18n/ui';

interface Props {
    lang: Lang;
    /** The small uppercase line above the title. Left out where a section has none. */
    eyebrowKey?: TranslationKey;
    titleKey: TranslationKey;
    subtitleKey?: TranslationKey;
    /** Already-composed copy, for a subtitle that is not a plain lookup. */
    subtitle?: string;
}

const { lang, eyebrowKey, titleKey, subtitleKey, subtitle } = Astro.props;
const t = useTranslations(lang);
---

<div class="section-header" data-reveal>
    {eyebrowKey && <span class="section-eyebrow">{t(eyebrowKey)}</span>}
    <h2 class="section-title">{t(titleKey)}</h2>
    <p class="section-subtitle">{subtitle ?? (subtitleKey && t(subtitleKey))}</p>
</div>
