---
/**
 * The four features, each as a split: the screenshot on one side, the writing on the
 * other, alternating sides down the page.
 *
 * This is the page's main structural device. A stack of text blocks can only vary by
 * type and space; a split alternating against a screenshot gives the eye somewhere to
 * land on every scroll, and lets the copy be short because the picture is carrying the
 * "what does it look like" half of the job.
 *
 * The alternation comes from the index, so inserting a feature re-alternates the rest by
 * itself — and the numbering, the colour and the screenshot slot all come from
 * `data/features.ts` for the same reason.
 */
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import { features } from '@/data/features';
import ProductShot from '@/components/ProductShot.astro';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="what" class="entries wrap" data-reveal>
    <div class="opener">
        <span class="numeral" aria-hidden="true">02</span>
        <p class="kicker">{t('features.heading')}</p>
        <h2>{t('features.title')}</h2>
    </div>

    {
        features.map((feature, i) => (
            <article class:list={['entry', { flipped: i % 2 === 1 }]} style={`--c: var(--c-${feature.tone})`}>
                <div class="entry-shot">
                    <ProductShot
                        lang={lang}
                        captionKey={feature.shot.captionKey}
                        ratio={feature.shot.ratio}
                        hint={feature.shot.hint}
                    />
                </div>

                <div class="entry-copy">
                    <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                    <h3>{t(feature.titleKey)}</h3>
                    <p class="lead">{t(feature.leadKey)}</p>
                    <ul class="details">
                        {feature.detailKeys.map((key) => (
                            <li>{t(key)}</li>
                        ))}
                    </ul>
                </div>
            </article>
        ))
    }
</section>

<style>
    .entries {
        padding-block: clamp(56px, 8vw, 104px) clamp(64px, 9vw, 116px);
    }

    .opener {
        margin-block-end: clamp(36px, 5vw, 64px);
    }

    .entry {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
        gap: clamp(28px, 5vw, 76px);
        align-items: center;
        padding-block: clamp(36px, 5vw, 72px);
    }

    /* Order rather than direction: `direction: rtl` would also flip the text inside. */
    .entry.flipped .entry-shot {
        order: 2;
    }

    .entry-copy {
        display: flex;
        flex-direction: column;
        gap: clamp(10px, 1.4vw, 16px);
        min-width: 0;
    }

    .idx {
        font-family: var(--mono);
        font-size: 12px;
        font-weight: 620;
        letter-spacing: 0.1em;
        color: var(--c);
        font-variant-numeric: tabular-nums;
    }

    .entry h3 {
        font-size: clamp(24px, 2.8vw, 38px);
        font-weight: 300;
        letter-spacing: -0.034em;
        max-width: 18ch;
    }

    .lead {
        font-size: clamp(16px, 1.15vw, 18px);
        font-weight: 350;
        line-height: 1.6;
        color: var(--ink-soft);
        max-width: 52ch;
    }

    /* The specifics. A hairline in the feature's own colour rather than bullets: it ties
       each detail back to the numeral without adding a second kind of list marker. */
    .details {
        list-style: none;
        margin: clamp(4px, 0.8vw, 10px) 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 11px;
        max-width: 52ch;
    }

    .details li {
        font-size: 14.5px;
        line-height: 1.55;
        color: var(--muted);
        padding-inline-start: 15px;
        border-inline-start: 2px solid color-mix(in srgb, var(--c) 45%, transparent);
    }

    @media (max-width: 860px) {
        .entry {
            grid-template-columns: minmax(0, 1fr);
            gap: 24px;
            padding-block: clamp(30px, 6vw, 44px);
        }

        /* One column: the picture always leads, whichever side it would have taken. */
        .entry.flipped .entry-shot {
            order: 0;
        }
    }
</style>
