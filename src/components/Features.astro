---
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import { features } from '@/data/features';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="what" class="entries wrap">
    <h2 class="section-head">{t('features.heading')}</h2>

    {
        features.map((feature, i) => (
            <article class="entry" style={`--c: var(--c-${feature.tone})`}>
                <div class="entry-head">
                    {/* Numbered from the array, so inserting a feature renumbers the rest. */}
                    <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                    <h3>{t(feature.titleKey)}</h3>
                </div>
                <div class="entry-body">
                    <p class="lead">{t(feature.leadKey)}</p>
                    <ul class="details">
                        {feature.detailKeys.map((key) => (
                            <li>{t(key)}</li>
                        ))}
                    </ul>
                </div>
            </article>
        ))
    }
</section>

<style>
    .entries {
        padding-block: clamp(48px, 6vw, 84px) clamp(64px, 9vw, 116px);
    }

    .section-head {
        font-size: clamp(11px, 1vw, 12.5px);
        font-weight: 640;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
        margin-block-end: clamp(28px, 4vw, 48px);
    }

    .entry {
        display: grid;
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
        gap: clamp(24px, 5vw, 72px);
        align-items: start;
        padding-block: clamp(30px, 4vw, 52px);
        /* The hairline IS the separator. No card, no background, no shadow. */
        border-block-start: 1px solid var(--hair);
    }

    .entry:first-of-type {
        border-block-start-color: transparent;
        padding-block-start: 0;
    }

    .entry-head {
        display: flex;
        align-items: baseline;
        gap: clamp(14px, 2vw, 24px);
    }

    .idx {
        font-family: var(--mono);
        font-size: clamp(12px, 1vw, 13px);
        font-weight: 620;
        letter-spacing: 0.06em;
        color: var(--c);
        padding-block-start: 0.35em;
        flex-shrink: 0;
        font-variant-numeric: tabular-nums;
    }

    .entry h3 {
        font-size: clamp(23px, 2.7vw, 36px);
        letter-spacing: -0.026em;
    }

    .entry-body {
        display: flex;
        flex-direction: column;
        gap: clamp(14px, 1.8vw, 20px);
    }

    .lead {
        font-size: clamp(16px, 1.15vw, 18px);
        color: var(--ink-soft);
        max-width: 56ch;
    }

    /* The specifics. A hairline in the feature's own colour rather than bullets: it ties
       each detail back to the numeral without adding a second kind of list marker. */
    .details {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-width: 56ch;
    }

    .details li {
        font-size: 15px;
        line-height: 1.55;
        color: var(--muted);
        padding-inline-start: 15px;
        border-inline-start: 2px solid color-mix(in srgb, var(--c) 45%, transparent);
    }
</style>
