---
import { localisePath, useTranslations } from '@/i18n/utils';
import { ui, type Lang } from '@/i18n/ui';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const bare = lang === 'en' ? Astro.url.pathname : Astro.url.pathname.replace(`/${lang}`, '') || '/';
const options = (Object.keys(ui) as Lang[]).map((code) => ({
    code,
    href: localisePath(code, bare),
    current: code === lang,
}));
---

<div class="lang-toggle-wrap" role="group" aria-label={t('nav.language')}>
    {
        options.map((option) => (
            <a
                href={option.href}
                hreflang={option.code}
                data-astro-history="replace"
                class:list={['lang-pill', { active: option.current }]}
                aria-current={option.current ? 'true' : undefined}
            >
                {option.code.toUpperCase()}
            </a>
        ))
    }
</div>

<style>
    .lang-toggle-wrap {
        display: inline-flex;
        align-items: center;
        padding: 3px;
        border-radius: var(--radius-full);
        border: 1px solid var(--border-color);
        background: var(--bg-panel-color);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .lang-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 4px 10px;
        border-radius: var(--radius-full);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        text-decoration: none;
        transition: all 0.18s ease;
    }

    .lang-pill:hover {
        color: var(--text-color);
    }

    .lang-pill.active {
        background: linear-gradient(135deg, #16a085 0%, #0e6655 100%);
        color: #ffffff;
        box-shadow: 0 2px 8px rgba(22, 160, 133, 0.3);
    }
</style>
