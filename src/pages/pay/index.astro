---
import Base from '@/layouts/Base.astro';
import PaySheet from '@/components/PaySheet.astro';
import '@/styles/pay.css';
import { useTranslations } from '@/i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<Base lang={lang} title={t('pay.title')} description={t('pay.secured')} noindex icons={[]}>
    <!-- Stripe.js must be the real remote script: it refuses to run when served from
         another origin, and bundling it would break card tokenisation. `is:inline`
         keeps Astro from trying to process it. -->
    <script is:inline src="https://js.stripe.com/v3/" slot="head"></script>
    <PaySheet lang={lang} />
</Base>

<script src="@/scripts/pay.ts"></script>
