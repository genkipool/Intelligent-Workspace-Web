---
/**
 * The same support centre in every other language, at the same path under its prefix. See
 * `pages/support/` for why the route is not translated along with the copy.
 */
import Base from '@/layouts/Base.astro';
import SupportCenter from '@/components/SupportCenter.astro';
import { prefixedLangPaths, useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

export const getStaticPaths = prefixedLangPaths;

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<Base
    lang={lang}
    title={t('support.meta.title')}
    description={t('support.meta.description')}
    icons={[
        'sun',
        'moon',
        'back',
        'clock',
        'note',
        'github',
        'chromeStore',
        'chevronDown',
        'bookOpen',
        'keyboardKeys',
        'shieldCheck',
        'heart',
    ]}
>
    <SupportCenter lang={lang} />
</Base>
