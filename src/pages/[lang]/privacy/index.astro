---
/**
 * The same policy in every other language, at the same path under its prefix. See
 * `pages/privacy/` for why the route is not translated along with the copy.
 */
import Base from '@/layouts/Base.astro';
import PrivacyPolicy from '@/components/PrivacyPolicy.astro';
import { prefixedLangPaths, useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

export const getStaticPaths = prefixedLangPaths;

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<Base
    lang={lang}
    title={t('privacy.meta.title')}
    description={t('privacy.meta.description')}
    icons={['sun', 'moon', 'back', 'lock', 'key', 'shield', 'github']}
>
    <PrivacyPolicy lang={lang} />
</Base>
